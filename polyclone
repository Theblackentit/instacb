<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>PolyChat — AI Character Chat</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;600;700;800;900&family=DM+Sans:ital,wght@0,300;0,400;0,500;0,600;1,400&display=swap" rel="stylesheet">
<style>
:root {
  --bg: #080612;
  --bg2: #0d0a1a;
  --bg3: #110e20;
  --bg-card: #130f22;
  --bg-hover: #1a1530;
  --bg-input: #0f0c1d;
  --surface: #181330;
  --surface2: #1e1840;
  --a1: #9b6dff;
  --a2: #f060b0;
  --a3: #60c8ff;
  --grad: linear-gradient(135deg, #9b6dff 0%, #f060b0 100%);
  --grad2: linear-gradient(135deg, #7c3aed 0%, #db2777 100%);
  --grad-soft: linear-gradient(135deg, rgba(155,109,255,.15) 0%, rgba(240,96,176,.15) 100%);
  --t1: #f0eeff;
  --t2: #9590bf;
  --t3: #534f78;
  --t4: #302c50;
  --border: rgba(120,100,220,.1);
  --border2: rgba(120,100,220,.2);
  --border3: rgba(155,109,255,.35);
  --r: 14px;
  --r-sm: 10px;
  --r-xs: 7px;
  --sidebar: 248px;
  --right: 310px;
  --shadow: 0 8px 32px rgba(0,0,0,.4);
  --glow: 0 0 30px rgba(155,109,255,.15);
}

*, *::before, *::after { margin:0; padding:0; box-sizing:border-box; }
html, body { height:100%; overflow:hidden; }
body {
  font-family: 'DM Sans', -apple-system, sans-serif;
  background: var(--bg);
  color: var(--t1);
  display: flex;
  height: 100vh;
  -webkit-font-smoothing: antialiased;
}

/* Noise texture overlay */
body::after {
  content:'';
  position:fixed;
  inset:0;
  background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='0.025'/%3E%3C/svg%3E");
  pointer-events:none;
  z-index:9999;
  opacity:.5;
}

::-webkit-scrollbar { width:4px; height:4px; }
::-webkit-scrollbar-track { background:transparent; }
::-webkit-scrollbar-thumb { background:var(--t4); border-radius:2px; }
::-webkit-scrollbar-thumb:hover { background:var(--t3); }

/* ══════════════════════════════════════
   SIDEBAR
══════════════════════════════════════ */
.sidebar {
  width: var(--sidebar);
  background: var(--bg2);
  border-right: 1px solid var(--border);
  display: flex;
  flex-direction: column;
  height: 100vh;
  flex-shrink: 0;
  z-index: 10;
  position: relative;
}
.sidebar::before {
  content:'';
  position:absolute;
  top:0; left:0; right:0;
  height:200px;
  background: radial-gradient(ellipse at 50% 0%, rgba(155,109,255,.1) 0%, transparent 70%);
  pointer-events:none;
}

.sb-logo {
  padding: 20px 18px 16px;
  border-bottom: 1px solid var(--border);
  position: relative;
}
.logo-mark {
  display: flex;
  align-items: center;
  gap: 9px;
  margin-bottom: 3px;
}
.logo-icon {
  width: 30px;
  height: 30px;
  border-radius: 8px;
  background: var(--grad);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 15px;
  flex-shrink: 0;
  box-shadow: 0 4px 14px rgba(155,109,255,.4);
}
.logo-text {
  font-family: 'Syne', sans-serif;
  font-size: 18px;
  font-weight: 800;
  letter-spacing: -.3px;
  background: var(--grad);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}
.logo-sub {
  font-size: 10px;
  color: var(--t3);
  letter-spacing: .06em;
  font-weight: 500;
  text-transform: uppercase;
  padding-left: 39px;
}

.sb-nav {
  padding: 10px 8px;
  border-bottom: 1px solid var(--border);
  display: flex;
  flex-direction: column;
  gap: 2px;
}
.nav-btn {
  display: flex;
  align-items: center;
  gap: 9px;
  padding: 9px 11px;
  border-radius: var(--r-sm);
  cursor: pointer;
  color: var(--t2);
  font-family: 'DM Sans', sans-serif;
  font-size: 13px;
  font-weight: 500;
  transition: all .15s;
  border: none;
  background: none;
  width: 100%;
  text-align: left;
  white-space: nowrap;
  position: relative;
}
.nav-btn:hover { background: var(--bg-hover); color: var(--t1); }
.nav-btn.active {
  background: linear-gradient(90deg, rgba(155,109,255,.14), rgba(240,96,176,.06));
  color: var(--a1);
  border: 1px solid rgba(155,109,255,.18);
}
.nav-btn.active::before {
  content:'';
  position:absolute;
  left:0;top:20%;bottom:20%;
  width:2px;border-radius:2px;
  background:var(--grad);
}
.nav-btn svg { width:15px; height:15px; flex-shrink:0; opacity:.75; }
.nav-btn.active svg { opacity:1; }

.nav-create {
  margin: 8px;
  padding: 9px 14px;
  background: var(--grad);
  border: none;
  border-radius: var(--r-sm);
  color: #fff;
  font-family: 'DM Sans', sans-serif;
  font-size: 12.5px;
  font-weight: 600;
  cursor: pointer;
  display: flex;
  align-items: center;
  gap: 7px;
  transition: opacity .18s, transform .12s;
  box-shadow: 0 4px 16px rgba(155,109,255,.3);
  width: calc(100% - 16px);
}
.nav-create:hover { opacity:.9; transform:translateY(-1px); }
.nav-create:active { transform:translateY(0); }
.nav-create svg { width:14px; height:14px; }

.sb-section {
  font-size: 9.5px;
  font-weight: 700;
  color: var(--t3);
  text-transform: uppercase;
  letter-spacing: .1em;
  padding: 12px 12px 5px;
}
.sb-chats {
  flex: 1;
  overflow-y: auto;
  padding: 4px 6px 8px;
}

.chat-row {
  display: flex;
  align-items: center;
  gap: 9px;
  padding: 7px 8px;
  border-radius: var(--r-sm);
  cursor: pointer;
  transition: background .15s;
  position: relative;
}
.chat-row:hover { background: var(--bg-hover); }
.chat-row.active {
  background: linear-gradient(90deg, rgba(155,109,255,.12), transparent);
  border: 1px solid rgba(155,109,255,.14);
}
.cav {
  width:34px; height:34px;
  border-radius:50%;
  object-fit:cover;
  flex-shrink:0;
  background:var(--bg-hover);
  border: 1.5px solid var(--border2);
}
.cav-ph {
  width:34px; height:34px;
  border-radius:50%;
  flex-shrink:0;
  display:flex;
  align-items:center;
  justify-content:center;
  font-family:'Syne',sans-serif;
  font-size:13px;
  font-weight:800;
  background:var(--grad);
  color:#fff;
  border: 1.5px solid rgba(155,109,255,.3);
}
.cav-ph.small { width:28px; height:28px; font-size:11px; }
.chat-row-info { flex:1; min-width:0; }
.chat-row-name {
  font-size:12px;
  font-weight:600;
  color:var(--t1);
  white-space:nowrap;
  overflow:hidden;
  text-overflow:ellipsis;
}
.chat-row-prev {
  font-size:10.5px;
  color:var(--t3);
  white-space:nowrap;
  overflow:hidden;
  text-overflow:ellipsis;
  margin-top:1px;
}
.chat-row-del {
  opacity:0;
  transition:opacity .15s;
  background:none;
  border:none;
  color:var(--t3);
  cursor:pointer;
  font-size:13px;
  padding:2px 4px;
  border-radius:4px;
  line-height:1;
}
.chat-row:hover .chat-row-del { opacity:1; }
.chat-row-del:hover { color:var(--a2); background:rgba(240,96,176,.1); }

/* ══════════════════════════════════════
   MAIN
══════════════════════════════════════ */
.main {
  flex:1;
  display:flex;
  flex-direction:column;
  height:100vh;
  overflow:hidden;
  min-width:0;
  position:relative;
}

/* ══════════════════════════════════════
   HOME
══════════════════════════════════════ */
#homeView { flex:1; display:flex; flex-direction:column; overflow:hidden; }
.home-wrap { flex:1; overflow-y:auto; padding:32px 36px 24px; }

.home-hero {
  margin-bottom: 28px;
  position: relative;
}
.hero-badge {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 4px 11px;
  background: rgba(155,109,255,.1);
  border: 1px solid rgba(155,109,255,.25);
  border-radius: 20px;
  font-size: 10.5px;
  font-weight: 600;
  color: var(--a1);
  letter-spacing: .04em;
  margin-bottom: 12px;
  text-transform: uppercase;
}
.hero-badge::before {
  content:'●';
  font-size:8px;
  color:#4ade80;
  animation: pulse 2s infinite;
}
@keyframes pulse { 0%,100%{opacity:1}50%{opacity:.4} }
.page-title {
  font-family: 'Syne', sans-serif;
  font-size: 30px;
  font-weight: 900;
  letter-spacing: -.6px;
  background: var(--grad);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  line-height: 1.1;
  margin-bottom: 7px;
}
.page-sub { font-size:13.5px; color:var(--t2); line-height:1.5; }

.filter-row {
  display: flex;
  align-items: center;
  gap: 8px;
  margin-bottom: 20px;
  flex-wrap: wrap;
}
.search-wrap {
  flex:1;
  display:flex;
  align-items:center;
  gap:10px;
  background:var(--bg-card);
  border:1px solid var(--border2);
  border-radius: 24px;
  padding: 0 14px;
  transition: border-color .2s;
  min-width:200px;
}
.search-wrap:focus-within { border-color:rgba(155,109,255,.4); box-shadow:0 0 0 3px rgba(155,109,255,.07); }
.search-wrap svg { width:14px; height:14px; color:var(--t3); flex-shrink:0; }
.search-in {
  flex:1;
  padding:10px 0;
  background:none;
  border:none;
  color:var(--t1);
  font-family:'DM Sans',sans-serif;
  font-size:13px;
  outline:none;
}
.search-in::placeholder { color:var(--t3); }

.tag-filters { display:flex; gap:5px; flex-wrap:wrap; }
.tag-filter-btn {
  padding: 6px 13px;
  border-radius: 20px;
  font-size: 11.5px;
  font-weight: 600;
  border: 1px solid var(--border2);
  background: var(--bg-card);
  color: var(--t2);
  cursor: pointer;
  transition: all .15s;
  font-family: 'DM Sans', sans-serif;
  letter-spacing: .01em;
}
.tag-filter-btn:hover { border-color:var(--border3); color:var(--a1); }
.tag-filter-btn.active {
  background: var(--grad);
  color: #fff;
  border-color: transparent;
  box-shadow: 0 3px 12px rgba(155,109,255,.3);
}

.section-label {
  font-family: 'Syne', sans-serif;
  font-size: 11px;
  font-weight: 700;
  color: var(--t3);
  text-transform: uppercase;
  letter-spacing: .1em;
  margin-bottom: 12px;
}

.chars-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(155px, 1fr));
  gap: 12px;
}

.char-card {
  background: var(--bg-card);
  border: 1px solid var(--border);
  border-radius: var(--r);
  overflow: hidden;
  cursor: pointer;
  transition: all .22s cubic-bezier(.2,.8,.4,1);
  position: relative;
  group: true;
}
.char-card:hover {
  border-color: rgba(155,109,255,.4);
  transform: translateY(-4px);
  box-shadow: 0 16px 40px rgba(0,0,0,.5), 0 0 0 1px rgba(155,109,255,.1), 0 0 30px rgba(155,109,255,.08);
}
.char-img {
  width:100%;
  aspect-ratio:3/4;
  object-fit:cover;
  display:block;
  background: linear-gradient(160deg,#1a1533,#26194a);
}
.char-img-ph {
  width:100%;
  aspect-ratio:3/4;
  background: linear-gradient(160deg,#1a1533,#26194a);
  display:flex;
  align-items:center;
  justify-content:center;
  font-family:'Syne',sans-serif;
  font-size:52px;
  font-weight:900;
  color:rgba(155,109,255,.25);
  user-select:none;
  position:relative;
}
.char-img-ph::after {
  content:'';
  position:absolute;
  inset:0;
  background: radial-gradient(ellipse at 50% 80%, rgba(155,109,255,.08) 0%, transparent 70%);
}
.char-gradient {
  position:absolute;
  bottom:0; left:0; right:0;
  height:70px;
  background:linear-gradient(to top, rgba(13,10,26,.95) 0%, transparent 100%);
  pointer-events:none;
}
.char-info {
  padding: 10px 12px 11px;
  background: var(--bg-card);
}
.char-name {
  font-family:'Syne',sans-serif;
  font-size:13.5px;
  font-weight:700;
  margin-bottom:3px;
  white-space:nowrap;
  overflow:hidden;
  text-overflow:ellipsis;
}
.char-tline {
  font-size:11px;
  color:var(--t2);
  line-height:1.4;
  display:-webkit-box;
  -webkit-line-clamp:2;
  -webkit-box-orient:vertical;
  overflow:hidden;
}
.char-tags-row {
  display:flex; gap:4px; flex-wrap:wrap; margin-top:6px;
}
.char-mini-tag {
  font-size:9px;
  font-weight:700;
  padding:2px 7px;
  border-radius:10px;
  background:rgba(155,109,255,.12);
  color:rgba(165,140,255,.85);
  border:1px solid rgba(155,109,255,.18);
  letter-spacing:.02em;
  text-transform:uppercase;
}

.card-btns {
  position:absolute;
  top:7px; right:7px;
  display:flex; gap:3px;
  opacity:0;
  transition:opacity .2s;
}
.char-card:hover .card-btns { opacity:1; }
.cb {
  width:27px; height:27px;
  border-radius:6px;
  border:none;
  cursor:pointer;
  display:flex;
  align-items:center;
  justify-content:center;
  font-size:12px;
  backdrop-filter:blur(8px);
  transition:all .15s;
}
.cb.edit { background:rgba(13,10,26,.7); color:var(--t2); border:1px solid rgba(255,255,255,.1); }
.cb.edit:hover { background:rgba(155,109,255,.8); color:#fff; }
.cb.del { background:rgba(13,10,26,.7); color:var(--t2); border:1px solid rgba(255,255,255,.1); }
.cb.del:hover { background:rgba(240,96,176,.8); color:#fff; }

.char-msgs-count {
  position:absolute;
  bottom:66px; right:8px;
  font-size:9px;
  color:rgba(255,255,255,.6);
  background:rgba(0,0,0,.5);
  border-radius:10px;
  padding:2px 7px;
  backdrop-filter:blur(4px);
  font-weight:600;
  opacity:0;
  transition:opacity .2s;
}
.char-card:hover .char-msgs-count { opacity:1; }

.empty-state {
  grid-column:1/-1;
  text-align:center;
  padding:80px 20px;
  color:var(--t2);
}
.empty-ico {
  font-size:52px;
  margin-bottom:16px;
  opacity:.2;
  display:block;
  filter:grayscale(1);
}
.empty-title {
  font-family:'Syne',sans-serif;
  font-size:18px;
  font-weight:800;
  color:var(--t1);
  margin-bottom:7px;
}
.empty-sub { font-size:13px; color:var(--t3); margin-bottom:22px; }

/* ══════════════════════════════════════
   CHAT VIEW
══════════════════════════════════════ */
#chatView { flex:1; display:flex; overflow:hidden; }
.chat-wrap { flex:1; display:flex; height:100vh; min-height:0; }
.chat-center { flex:1; display:flex; flex-direction:column; min-width:0; }

.chat-header {
  padding: 12px 16px;
  border-bottom: 1px solid var(--border);
  background: var(--bg2);
  display: flex;
  align-items: center;
  gap: 10px;
  flex-shrink: 0;
  position: relative;
}
.chat-header::after {
  content:'';
  position:absolute;
  bottom:-1px;left:0;right:0;
  height:1px;
  background:var(--grad);
  opacity:.15;
}

.back-btn {
  display:flex;
  align-items:center;
  gap:5px;
  padding:6px 11px;
  background:var(--bg-hover);
  border:1px solid var(--border2);
  border-radius:var(--r-xs);
  color:var(--t2);
  font-family:'DM Sans',sans-serif;
  font-size:12px;
  cursor:pointer;
  transition:all .15s;
  flex-shrink:0;
}
.back-btn:hover { color:var(--t1); border-color:var(--border3); }
.back-btn svg { width:12px; height:12px; }

.ch-av {
  width:38px; height:38px;
  border-radius:50%;
  object-fit:cover;
  background:var(--bg-hover);
  border:2px solid rgba(155,109,255,.25);
}
.ch-av-ph {
  width:38px; height:38px;
  border-radius:50%;
  display:flex;
  align-items:center;
  justify-content:center;
  font-family:'Syne',sans-serif;
  font-size:15px;
  font-weight:800;
  background:var(--grad);
  color:#fff;
  flex-shrink:0;
  box-shadow:0 0 16px rgba(155,109,255,.3);
}
.ch-info { flex:1; min-width:0; }
.ch-name {
  font-family:'Syne',sans-serif;
  font-size:15px;
  font-weight:700;
  white-space:nowrap;
  overflow:hidden;
  text-overflow:ellipsis;
}
.ch-tline { font-size:11px; color:var(--t2); margin-top:1px; }

.header-actions { display:flex; gap:6px; align-items:center; }
.hdr-btn {
  padding:6px 13px;
  background:var(--bg-hover);
  border:1px solid var(--border2);
  border-radius:var(--r-xs);
  color:var(--t2);
  font-family:'DM Sans',sans-serif;
  font-size:11.5px;
  font-weight:500;
  cursor:pointer;
  transition:all .15s;
  flex-shrink:0;
  white-space:nowrap;
  display:flex;
  align-items:center;
  gap:5px;
}
.hdr-btn:hover { color:var(--a1); border-color:rgba(155,109,255,.35); }
.hdr-btn svg { width:11px; height:11px; }

.model-bar {
  display:flex;
  align-items:center;
  gap:8px;
  padding:7px 16px;
  border-bottom:1px solid var(--border);
  background:var(--bg3);
  flex-shrink:0;
}
.model-lbl { font-size:10.5px; color:var(--t3); font-weight:500; }
.model-sel {
  background:var(--bg-input);
  border:1px solid var(--border2);
  border-radius:20px;
  padding:3px 11px;
  color:var(--t1);
  font-family:'DM Sans',sans-serif;
  font-size:11px;
  outline:none;
  cursor:pointer;
  transition:border-color .15s;
}
.model-sel:focus { border-color:var(--border3); }
.conn-status { font-size:10.5px; margin-left:auto; font-weight:500; }

/* MESSAGES */
.msgs {
  flex:1;
  overflow-y:auto;
  padding:24px 20px;
  display:flex;
  flex-direction:column;
  gap:20px;
  min-height:0;
}

.msg { display:flex; gap:10px; max-width:82%; position:relative; animation:fadeUp .2s ease; }
.msg.user { align-self:flex-end; flex-direction:row-reverse; }
.msg.assistant { align-self:flex-start; }
@keyframes fadeUp { from{opacity:0;transform:translateY(6px)} to{opacity:1;transform:translateY(0)} }

.m-av {
  width:32px; height:32px;
  border-radius:50%;
  object-fit:cover;
  flex-shrink:0;
  margin-top:2px;
  background:var(--bg-hover);
  border:1.5px solid rgba(155,109,255,.2);
}
.m-av-ph {
  width:32px; height:32px;
  border-radius:50%;
  flex-shrink:0;
  margin-top:2px;
  display:flex;
  align-items:center;
  justify-content:center;
  font-family:'Syne',sans-serif;
  font-size:12px;
  font-weight:800;
  color:#fff;
}

.m-body { flex:1; min-width:0; }
.m-name {
  font-size:10.5px;
  font-weight:700;
  color:var(--t3);
  margin-bottom:4px;
  letter-spacing:.02em;
  text-transform:uppercase;
}
.msg.user .m-name { text-align:right; }

.m-bubble {
  padding:11px 15px;
  border-radius:18px;
  font-size:13.5px;
  line-height:1.68;
  word-break:break-word;
  white-space:pre-wrap;
  position:relative;
}
.msg.user .m-bubble {
  background:var(--grad);
  color:#fff;
  border-bottom-right-radius:4px;
  box-shadow:0 4px 16px rgba(155,109,255,.25);
}
.msg.assistant .m-bubble {
  background:var(--bg-card);
  border:1px solid var(--border2);
  color:var(--t1);
  border-bottom-left-radius:4px;
}

.m-actions {
  display:flex;
  gap:3px;
  margin-top:5px;
  opacity:0;
  transition:opacity .15s;
}
.msg:hover .m-actions { opacity:1; }
.msg.user .m-actions { justify-content:flex-end; }

.mab {
  padding:2px 8px;
  font-size:10px;
  font-family:'DM Sans',sans-serif;
