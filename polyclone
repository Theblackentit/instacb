}
function updateStorageInfo() {
  const el = document.getElementById('storageInfo');
  if (!el) return;
  const chars = S.chars.length;
  const convos = S.convos.length;
  const msgs = S.convos.reduce((a,c) => a + c.messages.length, 0);
  el.textContent = `${chars} character${chars!==1?'s':''} · ${convos} conversation${convos!==1?'s':''} · ${msgs} message${msgs!==1?'s':''} stored locally in IndexedDB`;
}

/* ═══════════════════════════════════════════
   DATA
═══════════════════════════════════════════ */
function exportData() {
  const blob = new Blob([JSON.stringify({chars:S.chars, convos:S.convos, v:2, exportedAt:Date.now()}, null, 2)], {type:'application/json'});
  Object.assign(document.createElement('a'), {href:URL.createObjectURL(blob), download:'polychat_backup.json'}).click();
  toast('Backup exported!', 'ok');
}
function importData(e) {
  const f = e.target.files[0]; if (!f) return;
  const r = new FileReader();
  r.onload = ev => {
    try {
      const d = JSON.parse(ev.target.result);
      if (d.chars) { S.chars = d.chars; saveChars(); }
      if (d.convos) { S.convos = d.convos; saveConvos(); }
      toast('Imported successfully!', 'ok');
      renderGrid(); renderSidebar(); renderTagFilters();
    } catch { toast('Invalid backup file', 'err'); }
  };
  r.readAsText(f);
  e.target.value = '';
}
function confirmClearAll() {
  confirm2(
    'Clear All Data?',
    'This will permanently delete all characters, conversations, and settings. This cannot be undone.',
    () => {
      S.chars = []; S.convos = []; S.model = ''; S.url = 'http://localhost:11434';
      saveChars(); saveConvos(); saveModel(); saveUrl();
      toast('All data cleared');
      showView('home');
    }
  );
}

