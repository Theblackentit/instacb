async function streamReply(char, cv) {
  if (S.streaming) return;
  S.streaming = true;
  const btn = document.getElementById('sendBtn');
  if (btn) btn.disabled = true;

  const model = S.model || document.getElementById('modelSel')?.value || '';
  if (!model) {
    toast('No model selected — check Settings', 'err');
    S.streaming = false;
    if (btn) btn.disabled = false;
    return;
  }

  const aMsg = {id:uid(), role:'assistant', content:'', ts:Date.now()};
  cv.messages.push(aMsg);
  const container = document.getElementById('msgs');
  container.insertAdjacentHTML('beforeend', msgHTML(aMsg, char));
  const bbl = document.getElementById('bbl_'+aMsg.id);
  if (bbl) bbl.innerHTML = '<div class="typing"><span></span><span></span><span></span></div>';
  scrollToBottom();

  try {
    const apiMsgs = buildMsgs(char, cv.messages.slice(0,-1));
    const res = await fetch(S.url + '/api/chat', {
      method: 'POST',
      headers: {'Content-Type':'application/json'},
      body: JSON.stringify({
        model,
        messages: apiMsgs,
        stream: true,
        options: { temperature: 0.92, top_p: 0.95, repeat_penalty: 1.1 }
      })
    });
    if (!res.ok) throw new Error('HTTP ' + res.status);

    const reader = res.body.getReader();
    const dec = new TextDecoder();
    let full = '';
    let firstChunk = true;

    while (true) {
      const {done, value} = await reader.read();
      if (done) break;
      const chunk = dec.decode(value, {stream:true});
      for (const line of chunk.split('\n').filter(Boolean)) {
        try {
          const d = JSON.parse(line);
          if (d.message?.content) {
            if (firstChunk) { if (bbl) bbl.innerHTML = ''; firstChunk = false; }
            full += d.message.content;
            if (bbl) {
              bbl.innerHTML = esc(full);
              bbl.classList.add('streaming');
            }
            const c = document.getElementById('msgs');
            const atBottom = c.scrollHeight - c.scrollTop - c.clientHeight < 120;
            if (atBottom) scrollToBottom();
          }
        } catch {}
      }
    }

    if (bbl) bbl.classList.remove('streaming');
    aMsg.content = full;

  } catch(err) {
    const errMsg = `[Connection error: ${err.message}. Make sure Ollama is running at ${S.url} with CORS enabled: OLLAMA_ORIGINS=* ollama serve]`;
    aMsg.content = errMsg;
    if (bbl) {
      bbl.classList.remove('streaming');
      bbl.innerHTML = `<span style="color:var(--a2);font-size:12px">⚠ ${esc(err.message)} — Make sure Ollama is running with OLLAMA_ORIGINS=* ollama serve</span>`;
    }
  }

  cv.updatedAt = Date.now();
  saveConvos();
  renderSidebar();
  S.streaming = false;
  if (btn) btn.disabled = false;
}

function buildMsgs(char, history) {
  const sys = buildSys(char);
  const out = [{role:'system', content:sys}];
  history.forEach(m => out.push({role:m.role, content:m.content}));
  return out;
}
function buildSys(char) {
  let p = `You are ${char.name}. Embody this character completely and authentically.`;
  if (char.description) p += `\n\nBackground & World:\n${char.description}`;
  if (char.personality) p += `\n\nPersonality, voice & behavior:\n${char.personality}`;
  if (char.exampleDialogue?.length) {
    p += '\n\nExample exchanges demonstrating your exact voice and style:';
    char.exampleDialogue.forEach(d => {
      if (d.human) p += `\nUser: ${d.human}`;
      if (d.char)  p += `\n${char.name}: ${d.char}`;
    });
  }
  p += `\n\nCore rules: Stay in character as ${char.name} at all times. Respond naturally and authentically. Never break character, add disclaimers, or use meta-commentary. Engage directly and fully with whatever the user says. Your responses should feel completely real and immersive.`;
  return p;
}

