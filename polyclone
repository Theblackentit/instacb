<script>
/* ═══════════════════════════════════════════
   STATE
═══════════════════════════════════════════ */
const S = {
  chars: [],
  convos: [],
  curConvId: null,
  curCharId: null,
  editId: null,
  models: [],
  model: '',
  url: 'http://localhost:11434',
  streaming: false,
  dlgItems: [],
  pendingAv: null,
  activeTagFilter: ''
};

/* ═══════════════════════════════════════════
   STORAGE
═══════════════════════════════════════════ */
const DB_NAME = 'polychat';
const DB_VERSION = 1;
const DB_STORE = 'app_state';
let dbPromise = null;

function openDb() {
  if (!('indexedDB' in window)) {
    return Promise.reject(new Error('IndexedDB is not available in this browser'));
  }
  if (dbPromise) return dbPromise;
  dbPromise = new Promise((resolve, reject) => {
    const req = indexedDB.open(DB_NAME, DB_VERSION);
    req.onupgradeneeded = () => {
      const db = req.result;
      if (!db.objectStoreNames.contains(DB_STORE)) {
        db.createObjectStore(DB_STORE, {keyPath:'key'});
      }
    };
    req.onsuccess = () => resolve(req.result);
    req.onerror = () => reject(req.error || new Error('Unable to open IndexedDB'));
    req.onblocked = () => reject(new Error('IndexedDB upgrade blocked by another open PolyChat tab'));
  });
  return dbPromise;
}

async function idbGet(key, fallback) {
  const db = await openDb();
  return new Promise((resolve, reject) => {
    const tx = db.transaction(DB_STORE, 'readonly');
    const req = tx.objectStore(DB_STORE).get(key);
    req.onsuccess = () => resolve(req.result ? req.result.value : fallback);
    req.onerror = () => reject(req.error || new Error('Unable to read ' + key));
  });
}

async function idbSet(key, value) {
  const db = await openDb();
  return new Promise((resolve, reject) => {
    const tx = db.transaction(DB_STORE, 'readwrite');
    tx.objectStore(DB_STORE).put({key, value});
    tx.oncomplete = resolve;
    tx.onerror = () => reject(tx.error || new Error('Unable to save ' + key));
    tx.onabort = () => reject(tx.error || new Error('Unable to save ' + key));
  });
}

function reportStorageError(err) {
  console.error(err);
  toast('IndexedDB save failed — your latest changes may not persist', 'err');
}

async function load() {
  const [chars, convos, model, url] = await Promise.all([
    idbGet('pc_chars', []),
    idbGet('pc_convos', []),
    idbGet('pc_model', ''),
    idbGet('pc_url', 'http://localhost:11434')
  ]);
  S.chars = Array.isArray(chars) ? chars : [];
  S.convos = Array.isArray(convos) ? convos : [];
  S.model = model || '';
  S.url = url || 'http://localhost:11434';
}
function saveChars() { return idbSet('pc_chars', S.chars).catch(reportStorageError); }
function saveConvos() { return idbSet('pc_convos', S.convos).catch(reportStorageError); }
function saveModel() { return idbSet('pc_model', S.model).catch(reportStorageError); }
function saveUrl() { return idbSet('pc_url', S.url).catch(reportStorageError); }

/* ═══════════════════════════════════════════
   UTILS
═══════════════════════════════════════════ */
function uid() { return Math.random().toString(36).slice(2,9) + Date.now().toString(36); }
function getChar(id) { return S.chars.find(c => c.id === id); }
function getConvo(id) { return S.convos.find(c => c.id === id); }
function esc(t) {
  if (!t) return '';
  return String(t)
    .replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;')
    .replace(/"/g,'&quot;').replace(/\n/g,'<br>');
}

function toast(msg, type='') {
  document.querySelectorAll('.toast').forEach(e => e.remove());
  const el = document.createElement('div');
  el.className = 'toast ' + type;
  el.textContent = msg;
  document.body.appendChild(el);
  setTimeout(() => {
    el.style.opacity = '0';
    el.style.transform = 'translateY(10px)';
    setTimeout(() => el.remove(), 350);
  }, 2800);
}

function grow(el) {
  el.style.height = 'auto';
  el.style.height = Math.min(el.scrollHeight, 120) + 'px';
}

function avatarEl(char, size='normal') {
  if (char?.avatar) {
    if (size === 'small') return `<img class="cav" src="${char.avatar}" alt="${char.name}">`;
    if (size === 'msg')   return `<img class="m-av" src="${char.avatar}" alt="${char.name}">`;
    if (size === 'head')  return `<img class="ch-av" src="${char.avatar}" alt="${char.name}">`;
    return `<img class="cav" src="${char.avatar}" alt="${char.name}">`;
  }
  if (size === 'msg')  return `<div class="m-av-ph" style="background:var(--grad)">${char?.name?.charAt(0)||'?'}</div>`;
  if (size === 'head') return `<div class="ch-av-ph">${char?.name?.charAt(0)||'?'}</div>`;
  const cl = size === 'small' ? 'cav-ph small' : 'cav-ph';
  return `<div class="${cl}">${char?.name?.charAt(0)||'?'}</div>`;
}

function confirm2(title, body, onConfirm) {
  const ov = document.createElement('div');
  ov.className = 'modal-overlay';
  ov.innerHTML = `<div class="modal">
    <div class="modal-icon">⚠️</div>
    <div class="modal-title">${title}</div>
    <div class="modal-body">${body}</div>
    <div class="modal-actions">
      <button class="modal-cancel" id="mCancel">Cancel</button>
      <button class="modal-confirm" id="mConfirm">Delete</button>
    </div>
  </div>`;
  document.body.appendChild(ov);
  ov.querySelector('#mCancel').onclick = () => ov.remove();
  ov.querySelector('#mConfirm').onclick = () => { ov.remove(); onConfirm(); };
  ov.onclick = e => { if (e.target === ov) ov.remove(); };
}

function getMsgCount(charId) {
  return S.convos.filter(c => c.characterId === charId)
    .reduce((a, c) => a + c.messages.length, 0);
}

/* ═══════════════════════════════════════════
   VIEW ROUTING
═══════════════════════════════════════════ */
function showView(view, d={}) {
  ['homeView','chatView','createView','settingsView'].forEach(id => {
    const el = document.getElementById(id);
    if (el) el.style.display = 'none';
  });
  document.querySelectorAll('.nav-btn').forEach(b => b.classList.remove('active'));

  if (view === 'home') {
    document.getElementById('homeView').style.display = '';
    document.getElementById('navHome').classList.add('active');
    renderGrid();
    renderTagFilters();
  } else if (view === 'chat') {
    document.getElementById('chatView').style.display = '';
    openChat(d.charId, d.convId);
  } else if (view === 'create') {
    document.getElementById('createView').style.display = '';
    setupForm(d.editId);
  } else if (view === 'settings') {
    document.getElementById('settingsView').style.display = '';
    document.getElementById('navSettings').classList.add('active');
    document.getElementById('urlIn').value = S.url;
    updateStorageInfo();
    checkConnStatus();
  }
  renderSidebar();
}

/* ═══════════════════════════════════════════
   HOME
═══════════════════════════════════════════ */
function renderTagFilters() {
  const allTags = [...new Set(S.chars.flatMap(c => c.tags||[]))].sort();
  const el = document.getElementById('tagFilters');
  if (!allTags.length) { el.innerHTML = ''; return; }
  const btns = ['all', ...allTags].map(t =>
    `<button class="tag-filter-btn ${(!S.activeTagFilter && t==='all') || S.activeTagFilter===t ? 'active' : ''}"
      onclick="setTagFilter('${t}')">${t === 'all' ? 'All' : t}</button>`
  ).join('');
  el.innerHTML = btns;
}
function setTagFilter(tag) {
  S.activeTagFilter = tag === 'all' ? '' : tag;
  renderTagFilters();
  renderGrid(document.getElementById('searchIn').value);
}

function renderGrid(filter='') {
  const grid = document.getElementById('charsGrid');
  let chars = S.chars;
  if (filter) {
    const f = filter.toLowerCase();
    chars = chars.filter(c =>
      c.name.toLowerCase().includes(f) ||
      (c.tagline||'').toLowerCase().includes(f) ||
      (c.tags||[]).some(t => t.toLowerCase().includes(f))
    );
  }
  if (S.activeTagFilter) {
    chars = chars.filter(c => (c.tags||[]).includes(S.activeTagFilter));
  }
  const label = document.getElementById('gridLabel');
  if (label) label.textContent = chars.length + ' Character' + (chars.length !== 1 ? 's' : '');

  if (!chars.length) {
    grid.innerHTML = `<div class="empty-state">
      <span class="empty-ico">🎭</span>
      <div class="empty-title">${filter || S.activeTagFilter ? 'No characters found' : 'No characters yet'}</div>
      <div class="empty-sub">${filter || S.activeTagFilter ? 'Try a different search or filter' : 'Create your first character to get started'}</div>
      ${(!filter && !S.activeTagFilter) ? `<button class="btn-p" onclick="showView('create')" style="margin:0 auto">Create Character</button>` : ''}
    </div>`;
    return;
  }
  grid.innerHTML = chars.map(c => {
    const msgCount = getMsgCount(c.id);
    const tagsHtml = (c.tags||[]).slice(0,3).map(t => `<span class="char-mini-tag">${esc(t)}</span>`).join('');
    return `<div class="char-card" onclick="startChat('${c.id}')">
      ${c.avatar
        ? `<img class="char-img" src="${c.avatar}" alt="${esc(c.name)}" loading="lazy">`
        : `<div class="char-img-ph">${c.name.charAt(0)}</div>`}
      <div class="char-gradient"></div>
      ${msgCount > 0 ? `<div class="char-msgs-count">${msgCount} msg${msgCount>1?'s':''}</div>` : ''}
      <div class="char-info">
        <div class="char-name">${esc(c.name)}</div>
        <div class="char-tline">${esc(c.tagline || 'Chat with this character')}</div>
        ${tagsHtml ? `<div class="char-tags-row">${tagsHtml}</div>` : ''}
      </div>
      <div class="card-btns">
        <button class="cb edit" onclick="event.stopPropagation();showView('create',{editId:'${c.id}'})" title="Edit">✎</button>
        <button class="cb del" onclick="event.stopPropagation();delChar('${c.id}')" title="Delete">✕</button>
      </div>
    </div>`;
  }).join('');
}
function filterChars(v) { renderGrid(v); }
function startChat(cid) { showView('chat', {charId:cid}); }
function delChar(cid) {
  const ch = getChar(cid);
  if (!ch) return;
  confirm2(
    `Delete "${ch.name}"?`,
    'This will permanently delete this character and all conversation history. This cannot be undone.',
    () => {
      S.chars = S.chars.filter(c => c.id !== cid);
      S.convos = S.convos.filter(c => c.characterId !== cid);
      saveChars(); saveConvos();
      renderGrid(document.getElementById('searchIn').value);
      renderTagFilters();
      renderSidebar();
      toast('Character deleted');
    }
  );
}

/* ═══════════════════════════════════════════
   SIDEBAR
═══════════════════════════════════════════ */
function renderSidebar() {
  const el = document.getElementById('recentList');
  const sorted = [...S.convos].sort((a,b) => b.updatedAt - a.updatedAt);
  if (!sorted.length) {
    el.innerHTML = '<div style="padding:10px 12px;font-size:11px;color:var(--t3)">No chats yet — pick a character to start!</div>';
    return;
  }
  el.innerHTML = sorted.slice(0,30).map(cv => {
    const ch = getChar(cv.characterId);
    if (!ch) return '';
    const last = cv.messages[cv.messages.length-1];
    const active = cv.id === S.curConvId;
    const prev = last ? (last.role==='user'?'You: ':ch.name+': ') + last.content.replace(/<br>/g,' ').slice(0,35) : 'Start chatting...';
    return `<div class="chat-row ${active?'active':''}" onclick="showView('chat',{charId:'${ch.id}',convId:'${cv.id}'})">
      ${avatarEl(ch,'small')}
      <div class="chat-row-info">
        <div class="chat-row-name">${esc(ch.name)}</div>
        <div class="chat-row-prev">${esc(prev)}</div>
      </div>
