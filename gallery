        img.outerHTML = `<video id="fs-img" class="fading" autoplay controls loop muted playsinline></video>`;
        const v = document.getElementById("fs-img");
        v.src = current;
      } else {
        if (img.tagName !== "IMG") {
          img.outerHTML = `<img id="fs-img" class="fading" src="" alt="fullscreen" />`;
        }
        document.getElementById("fs-img").src = current;
