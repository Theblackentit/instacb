  /* ══════════════════════════════════════════════════════════════════════════
     App State
  ══════════════════════════════════════════════════════════════════════════ */

  let allCharacters   = [];
  let imageCounts     = {};
  let selectedCharId  = null;
  let detailCharId    = null;
  let detailImages    = [];
  let fsIndex         = 0;

  /* ══════════════════════════════════════════════════════════════════════════
     Render: Main Gallery
  ══════════════════════════════════════════════════════════════════════════ */

  async function renderGallery(filterText = '') {
    const grid   = document.getElementById('char-grid');
    const empty  = document.getElementById('empty-state');
    const filter = filterText.toLowerCase().trim();

    const chars  = filter
      ? allCharacters.filter(c => c.name.toLowerCase().includes(filter))
      : allCharacters;

    if (chars.length === 0) {
      grid.innerHTML  = '';
      empty.style.display = 'flex';
    } else {
      empty.style.display = 'none';
      grid.innerHTML = chars.map(c => buildCardHTML(c)).join('');
    }

    document.getElementById('status-count').textContent =
      `${allCharacters.length} CHARACTER${allCharacters.length !== 1 ? 'S' : ''} LOADED`;
  }

  function buildCardHTML(char) {
    const count = imageCounts[char.id] ?? 0;
    const ox    = char.portraitOffsetX ?? 50;
    const oy    = char.portraitOffsetY ?? 20;
    const sc    = char.portraitScale   ?? 1;
    return `
      <div class="char-card" onclick="openCharChoiceModal(${char.id})" title="${escapeHTML(char.name)}">
        ${mediaHTML(
          char.portraitUrl,
          char.name,
          "card-portrait",
          `loading="lazy" style="object-position:${ox}% ${oy}%;transform:scale(${sc});transform-origin:${ox}% ${oy}%;" autoplay muted loop playsinline`
        )}
        <div class="char-card-overlay">
          <div class="char-card-name">${escapeHTML(char.name)}</div>
          <div class="char-card-count">${count} IMAGE${count !== 1 ? 'S' : ''}</div>
        </div>
        <div class="corner-br"></div>
      </div>
    `;
  }

  /* ══════════════════════════════════════════════════════════════════════════
     Character Choice Popup
  ══════════════════════════════════════════════════════════════════════════ */

  let choiceCharId = null;

  function openCharChoiceModal(charId) {
    const char = allCharacters.find(c => c.id === charId);
    if (!char) return;
    choiceCharId = charId;

    const ox = char.portraitOffsetX ?? 50;
    const oy = char.portraitOffsetY ?? 20;
    const sc = char.portraitScale   ?? 1;

    const portImg = document.getElementById('choice-portrait');
    const portVid = document.getElementById('choice-portrait-video');
    if (isVideoUrl(char.portraitUrl)) {
      portImg.style.display = 'none';
      portVid.style.display = 'block';
      portVid.src = char.portraitUrl;
      portVid.style.objectPosition  = `${ox}% ${oy}%`;
      portVid.style.transform       = `scale(${sc})`;
      portVid.style.transformOrigin = `${ox}% ${oy}%`;
      portVid.play().catch(() => {});
    } else {
      portVid.style.display = 'none';
      portVid.pause();
      portImg.style.display = 'block';
      portImg.src = char.portraitUrl;
      portImg.style.objectPosition  = `${ox}% ${oy}%`;
      portImg.style.transform       = `scale(${sc})`;
      portImg.style.transformOrigin = `${ox}% ${oy}%`;
    }

    document.getElementById('choice-char-name').textContent = char.name.toUpperCase();

    const count = imageCounts[char.id] ?? 0;
    document.getElementById('choice-char-sub').textContent =
      `${count} IMAGE${count !== 1 ? 'S' : ''} · CLICK TO OPEN`;

    document.getElementById('char-choice-overlay').classList.add('open');
    document.body.style.overflow = 'hidden';
  }

  function closeCharChoice() {
    document.getElementById('char-choice-overlay').classList.remove('open');
    document.body.style.overflow = '';
    const portVid = document.getElementById('choice-portrait-video');
    portVid.pause();
    choiceCharId = null;
  }

  function choiceSelectGallery() {
    const id = choiceCharId;
    closeCharChoice();
    if (id !== null) openDetailModal(id);
  }

  function choiceSelectChat() {
    const id = choiceCharId;
    closeCharChoice();
    if (id !== null) openChatModal(id);
  }

  /* Close choice popup when clicking backdrop */
  document.getElementById('char-choice-overlay').addEventListener('click', function(e) {
    if (e.target === this) closeCharChoice();
  });

  /* ══════════════════════════════════════════════════════════════════════════
     Render: Detail Modal (character gallery images)
  ══════════════════════════════════════════════════════════════════════════ */

  async function openDetailModal(charId) {
    detailCharId = charId;
    const char   = allCharacters.find(c => c.id === charId);
    if (!char) return;

    detailImages = await getImagesByCharacter(charId);

    document.getElementById('detail-char-name').textContent = char.name;
    document.getElementById('detail-img-count').textContent = `${detailImages.length} IMAGES`;

    const grid = document.getElementById('detail-grid');
    if (detailImages.length === 0) {
      grid.innerHTML = `
        <div style="grid-column:1/-1;padding:3rem;text-align:center;color:var(--muted);font-family:var(--font-mono);font-size:0.7rem;letter-spacing:0.2em;">
          NO IMAGES — PRESS F4 TO ADD
        </div>`;
