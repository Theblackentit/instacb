  function renderChatRightPanel(char) {
    const ox = char.portraitOffsetX ?? 50;
    const oy = char.portraitOffsetY ?? 20;
    const sc = char.portraitScale   ?? 1;

    document.getElementById('chat-right').innerHTML = `
      <div class="crp-portrait-wrap">
        ${char.portraitUrl
          ? `<img class="crp-portrait"
               src="${escapeHTML(char.portraitUrl)}"
               style="object-position:${ox}% ${oy}%;transform:scale(${sc});transform-origin:${ox}% ${oy}%;"
               onerror="this.style.display='none'" />`
          : `<div class="crp-portrait-ph">${escapeHTML(char.name.charAt(0))}</div>`}
        <div class="crp-grad"></div>
      </div>
      <div class="crp-body">
        <div class="crp-name">${escapeHTML(char.name)}</div>
        <div class="crp-count">${imageCounts[char.id] ?? 0} IMAGES IN GALLERY</div>
        ${char.aiStory ? `
          <div class="crp-section-title">STORY</div>
          <div class="crp-story">${escapeHTML(char.aiStory)}</div>
        ` : ''}
        ${char.aiPersonality ? `
          <div class="crp-section-title">PERSONALITY</div>
          <div class="crp-story">${escapeHTML(char.aiPersonality.slice(0, 160))}${char.aiPersonality.length > 160 ? '…' : ''}</div>
        ` : ''}
        <hr class="crp-divider" />
        <button class="crp-btn" onclick="exportChatConvo()">⬇ EXPORT CHAT</button>
        <button class="crp-btn red" onclick="confirmClearChat()">✕ CLEAR CHAT</button>
      </div>
    `;
  }

  function toggleChatRight() {
    document.getElementById('chat-right').classList.toggle('hidden');
  }

  /* ── Render Chat Messages ─────────────────────────────────────────────── */

  function renderChatMessages() {
    const container = document.getElementById('chat-msgs');
    const char = allCharacters.find(c => c.id === chatCharId);

    if (!chatConv || chatConv.messages.length === 0) {
      container.innerHTML = `
        <div style="text-align:center;padding:3rem 1rem;color:var(--muted);
                    font-family:var(--font-mono);font-size:0.65rem;letter-spacing:0.15em;">
          ◈ START OF CONVERSATION<br>
          <span style="font-size:0.55rem;opacity:0.6;display:block;margin-top:0.5rem;">
            ${char?.aiPersonality ? 'AI PERSONA CONFIGURED' : 'SET AI PERSONA IN F4 → EDIT CHARACTER'}
          </span>
        </div>`;
      return;
    }

    container.innerHTML = chatConv.messages.map(msg => chatMsgHTML(msg, char)).join('');
    scrollChatToBottom();
  }

  function chatMsgHTML(msg, char) {
    const initial = char ? char.name.charAt(0).toUpperCase() : '?';
    const name    = char ? char.name.toUpperCase() : 'AI';

    if (msg.role === 'user') {
      return `
        <div class="cmsg cmsg-user" data-id="${escapeHTML(msg.id)}">
          <div class="cmsg-name">YOU</div>
          <div class="cmsg-bubble cmsg-bubble-user">${chatRenderContent(msg.content)}</div>
        </div>`;
    } else {
      return `
        <div class="cmsg cmsg-assistant" data-id="${escapeHTML(msg.id)}">
          <div class="cmsg-av">${escapeHTML(initial)}</div>
          <div style="flex:1;min-width:0;">
            <div class="cmsg-name">${escapeHTML(name)}</div>
            <div class="cmsg-bubble cmsg-bubble-assistant" id="cbbl_${escapeHTML(msg.id)}">${chatRenderContent(msg.content)}</div>
          </div>
        </div>`;
    }
  }

  function chatRenderContent(text) {
    if (!text) return '';
    let s = String(text)
      .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;');
    // Style *action text* in italic/muted
    s = s.replace(/\*([^*\n]+)\*/g, '<span class="chat-action-text">*$1*</span>');
    s = s.replace(/\n/g, '<br>');
    return s;
  }

  /* ── Chat Input Helpers ───────────────────────────────────────────────── */

  function onChatKey(e) {
    if (e.key === 'Enter' && !e.shiftKey) {
      e.preventDefault();
      sendChatMsg();
    }
  }

  function growChatInput(el) {
    el.style.height = 'auto';
    el.style.height = Math.min(el.scrollHeight, 100) + 'px';
  }

  function scrollChatToBottom() {
    const c = document.getElementById('chat-msgs');
    if (c) c.scrollTop = c.scrollHeight;
  }

  /* ── Send Message ─────────────────────────────────────────────────────── */

  async function sendChatMsg() {
    if (chatStreaming) return;
    const inp  = document.getElementById('chat-textarea');
    const text = inp.value.trim();
    if (!text) return;
    inp.value = '';
    inp.style.height = 'auto';

    if (!chatConv) return;
    const char = allCharacters.find(c => c.id === chatCharId);
    if (!char) return;

    const userMsg = { id: chatUid(), role: 'user', content: text, ts: Date.now() };
    chatConv.messages.push(userMsg);
    chatConv.updatedAt = Date.now();
    await putChatConvo(chatConv);

    const container = document.getElementById('chat-msgs');
    container.insertAdjacentHTML('beforeend', chatMsgHTML(userMsg, char));
    scrollChatToBottom();

    await streamChatReply(char);
  }

  /* ── Stream Reply from Ollama ─────────────────────────────────────────── */

  async function streamChatReply(char) {
    if (chatStreaming) return;
    chatStreaming = true;
    const btn = document.getElementById('chat-send-btn');
    if (btn) btn.disabled = true;

    if (!ollamaModel) {
      const sel = document.getElementById('chat-model-sel');
      if (sel && sel.value) {
        ollamaModel = sel.value;
        localStorage.setItem('gal_ollama_model', ollamaModel);
      } else {
        showToast('⚠ No model selected — configure Ollama in F4 panel');
        chatStreaming = false;
        if (btn) btn.disabled = false;
        return;
      }
    }

    const aMsg = { id: chatUid(), role: 'assistant', content: '', ts: Date.now() };
    chatConv.messages.push(aMsg);

    const container = document.getElementById('chat-msgs');
    const initial   = char.name.charAt(0).toUpperCase();
    container.insertAdjacentHTML('beforeend', `
      <div class="cmsg cmsg-assistant" data-id="${escapeHTML(aMsg.id)}">
        <div class="cmsg-av">${escapeHTML(initial)}</div>
        <div style="flex:1;min-width:0;">
          <div class="cmsg-name">${escapeHTML(char.name.toUpperCase())}</div>
          <div class="cmsg-bubble cmsg-bubble-assistant" id="cbbl_${escapeHTML(aMsg.id)}">
            <div class="chat-typing"><span></span><span></span><span></span></div>
          </div>
        </div>
      </div>`);
    scrollChatToBottom();

    const bbl = document.getElementById('cbbl_' + aMsg.id);

    try {
      const apiMsgs = buildChatMsgs(char, chatConv.messages.slice(0, -1));
      const res = await fetch(ollamaUrl + '/api/chat', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          model: ollamaModel,
          messages: apiMsgs,
          stream: true,
          options: { temperature: 0.92, top_p: 0.95, repeat_penalty: 1.1 }
        })
      });

      if (!res.ok) throw new Error('HTTP ' + res.status);

      const reader = res.body.getReader();
      const dec    = new TextDecoder();
      let full      = '';
      let firstChunk = true;

      while (true) {
        const { done, value } = await reader.read();
        if (done) break;
        const chunk = dec.decode(value, { stream: true });
        for (const line of chunk.split('\n').filter(Boolean)) {
          try {
            const d = JSON.parse(line);
            if (d.message?.content) {
              if (firstChunk) { if (bbl) bbl.innerHTML = ''; firstChunk = false; }
              full += d.message.content;
              if (bbl) {
                bbl.innerHTML = chatRenderContent(full);
                bbl.classList.add('chat-streaming');
              }
              const msgsEl = document.getElementById('chat-msgs');
              if (msgsEl.scrollHeight - msgsEl.scrollTop - msgsEl.clientHeight < 140) {
                scrollChatToBottom();
              }
            }
          } catch { /* skip malformed JSON lines */ }
        }
      }

      if (bbl) bbl.classList.remove('chat-streaming');
      aMsg.content = full;

    } catch (err) {
      aMsg.content = `[Error: ${err.message}]`;
      if (bbl) {
        bbl.classList.remove('chat-streaming');
        bbl.innerHTML = `<span style="color:var(--accent);font-size:0.82rem;">
          ⚠ ${escapeHTML(err.message)}<br>
          <span style="font-size:0.72rem;opacity:0.75;">Make sure Ollama is running:<br>OLLAMA_ORIGINS=* ollama serve</span>
        </span>`;
      }
    }

    chatConv.updatedAt = Date.now();
    await putChatConvo(chatConv);

    chatStreaming = false;
    if (btn) btn.disabled = false;
  }

  function buildChatMsgs(char, history) {
    const sys = buildChatSys(char);
    const out = [{ role: 'system', content: sys }];
    history.forEach(m => {
      if (m.role === 'user' || m.role === 'assistant') {
        out.push({ role: m.role, content: m.content });
      }
    });
    return out;
  }

  function buildChatSys(char) {
    let p = `You are ${char.name}. Embody this character completely and authentically.`;
    if (char.aiStory)       p += `\n\nBackground & World:\n${char.aiStory}`;
    if (char.aiPersonality) p += `\n\nPersonality, voice & behavior:\n${char.aiPersonality}`;
    p += `\n\nCore rules: Stay in character as ${char.name} at all times. Respond naturally and authentically. Never break character, add disclaimers, or use meta-commentary. Engage directly and fully with whatever the user says.`;
    return p;
  }

  /* ── Ollama Model Loading ─────────────────────────────────────────────── */

  async function loadChatModels() {
    const sel      = document.getElementById('chat-model-sel');
    const dot      = document.getElementById('chat-conn-dot');
    const labelEl  = document.getElementById('chat-conn-label');
    const countEl  = document.getElementById('chat-conn-count');
    if (!sel) return;

    try {
      const res = await fetch(ollamaUrl + '/api/tags');
      if (!res.ok) throw new Error('HTTP ' + res.status);
      const data   = await res.json();
      const models = (data.models || []).map(m => m.name);

      sel.innerHTML = models.length
        ? models.map(m => `<option value="${escapeHTML(m)}" ${m === ollamaModel ? 'selected' : ''}>${escapeHTML(m)}</option>`).join('')
        : '<option value="">No models — run: ollama pull llama3.2</option>';

      if (!ollamaModel && models.length) {
        ollamaModel = models[0];
        localStorage.setItem('gal_ollama_model', ollamaModel);
      }

      if (dot)    { dot.className = 'chat-conn-dot online'; }
      if (labelEl) labelEl.textContent = 'ONLINE';
      if (countEl) countEl.textContent = `${models.length} MODEL${models.length !== 1 ? 'S' : ''}`;

    } catch {
      sel.innerHTML = '<option value="">Ollama offline</option>';
      if (dot)    dot.className = 'chat-conn-dot offline';
      if (labelEl) labelEl.textContent = 'OFFLINE';
      if (countEl) countEl.textContent = '';
    }
  }

  function onChatModelChange() {
    const sel = document.getElementById('chat-model-sel');
    if (sel && sel.value) {
      ollamaModel = sel.value;
      localStorage.setItem('gal_ollama_model', ollamaModel);
    }
  }

  /* ── Export & Clear Chat ──────────────────────────────────────────────── */

  function exportChatConvo() {
    if (!chatConv || !chatConv.messages.length) return showToast('⚠ No messages to export');
    const char = allCharacters.find(c => c.id === chatCharId);
    const name = char ? char.name : 'Character';
    const lines = chatConv.messages.map(m => {
      const who = m.role === 'user' ? 'You' : name;
      const ts  = new Date(m.ts).toLocaleTimeString();
      return `[${ts}] ${who}:\n${m.content}`;
    }).join('\n\n---\n\n');
    const blob = new Blob([lines], { type: 'text/plain' });
    const a = document.createElement('a');
    a.href     = URL.createObjectURL(blob);
    a.download = `${name.toLowerCase().replace(/\s+/g, '_')}_chat.txt`;
    a.click();
    showToast('✦ Chat exported');
  }

  async function confirmClearChat() {
    if (!confirm('Clear this conversation? This cannot be undone.')) return;
    if (!chatConv) return;
    await deleteChatConvoDB(chatConv.id);
    const char = allCharacters.find(c => c.id === chatCharId);
    chatConv = await createNewChatConv(char);
    renderChatMessages();
    showToast('✦ Conversation cleared');
  }

  </script>
