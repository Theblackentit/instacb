<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>GALLERY // SYSTEM</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@400;700;900&family=Rajdhani:wght@400;500;600;700&family=JetBrains+Mono:wght@400;700&family=DM+Sans:wght@400;500;600&display=swap" rel="stylesheet" />
  <style>
    /* ─── CSS Variables & Base ─────────────────────────────────────────── */
    :root {
      --bg:        #0a0a0c;
      --bg2:       #111116;
      --bg3:       #18181f;
      --card:      #14141a;
      --border:    #2a2a38;
      --lime:      #c8ff00;
      --lime2:     #a8d900;
      --cyan:      #00f5d4;
      --accent:    #ff4d8d;
      --text:      #e8e8f0;
      --muted:     #6b6b88;
      --font-head: 'Orbitron', sans-serif;
      --font-body: 'Rajdhani', sans-serif;
      --font-mono: 'JetBrains Mono', monospace;
      --font-chat: 'DM Sans', sans-serif;
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      background: var(--bg);
      color: var(--text);
      font-family: var(--font-body);
      min-height: 100vh;
      overflow-x: hidden;
    }

    /* Scanline overlay — header only */
    #main-header::before {
      content: '';
      position: absolute;
      inset: 0;
      background: repeating-linear-gradient(
        0deg,
        transparent,
        transparent 2px,
        rgba(0,0,0,0.08) 2px,
        rgba(0,0,0,0.08) 4px
      );
      pointer-events: none;
      z-index: 10;
    }

    /* Noise grain texture — header only */
    #main-header::after {
      content: '';
      position: absolute;
      inset: 0;
      background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noise'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.65' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noise)' opacity='0.04'/%3E%3C/svg%3E");
      opacity: 0.3;
      pointer-events: none;
      z-index: 9;
    }

    /* ─── Typography ───────────────────────────────────────────────────── */
    .font-head { font-family: var(--font-head); }
    .font-body { font-family: var(--font-body); }
    .font-mono { font-family: var(--font-mono); }

    /* ─── Header ───────────────────────────────────────────────────────── */
    #main-header {
      background: linear-gradient(180deg, #0a0a0c 0%, rgba(10,10,12,0.95) 100%);
      border-bottom: 1px solid var(--border);
      backdrop-filter: blur(12px);
      position: sticky;
      top: 0;
      z-index: 100;
      overflow: hidden;
    }

    .header-gallery-label {
      font-family: var(--font-head);
      font-size: clamp(1.2rem, 3vw, 1.8rem);
      font-weight: 900;
      letter-spacing: 0.3em;
      color: var(--lime);
      text-shadow: 0 0 20px var(--lime), 0 0 40px rgba(200,255,0,0.3);
      position: relative;
    }
    .header-gallery-label::before {
      content: '//';
      color: var(--muted);
      margin-right: 0.5em;
      font-size: 0.7em;
    }

    .unlock-btn {
      font-family: var(--font-mono);
      font-size: 0.65rem;
      letter-spacing: 0.1em;
      padding: 0.4rem 1rem;
      border: 1px solid var(--accent);
      color: var(--accent);
      background: rgba(255,77,141,0.08);
      cursor: pointer;
      transition: all 0.2s;
      text-transform: uppercase;
      position: relative;
      overflow: hidden;
    }
    .unlock-btn::before {
      content: '';
      position: absolute;
      inset: 0;
      background: var(--accent);
      transform: translateX(-100%);
      transition: transform 0.2s;
      z-index: -1;
    }
    .unlock-btn:hover { color: #fff; }
    .unlock-btn:hover::before { transform: translateX(0); }

    /* ─── Search Bar ───────────────────────────────────────────────────── */
    #search-input {
      background: var(--bg3);
      border: 1px solid var(--border);
      color: var(--text);
      font-family: var(--font-mono);
      font-size: 0.8rem;
      padding: 0.5rem 1rem 0.5rem 2.5rem;
      outline: none;
      transition: border-color 0.2s, box-shadow 0.2s;
      letter-spacing: 0.05em;
    }
    #search-input:focus {
      border-color: var(--lime);
      box-shadow: 0 0 0 2px rgba(200,255,0,0.15);
    }
    #search-input::placeholder { color: var(--muted); }

    /* ─── Character Cards ──────────────────────────────────────────────── */
    .char-card {
      position: relative;
      background: var(--card);
      border: 1px solid var(--border);
      overflow: hidden;
      cursor: pointer;
      transition: transform 0.3s cubic-bezier(0.34,1.56,0.64,1),
                  border-color 0.3s,
                  box-shadow 0.3s;
      aspect-ratio: 2/5;
    }

    .char-card::before {
      content: '';
      position: absolute;
      inset: 0;
      background: linear-gradient(135deg, rgba(200,255,0,0.05) 0%, transparent 60%);
      opacity: 0;
      transition: opacity 0.3s;
      z-index: 1;
    }

    .char-card::after {
      content: '';
      position: absolute;
      top: 0; left: 0;
      width: 18px; height: 18px;
      border-top: 2px solid var(--lime);
      border-left: 2px solid var(--lime);
      opacity: 0;
      transition: opacity 0.3s;
      z-index: 2;
    }

    .char-card:hover {
      transform: translateY(-6px) scale(1.02);
      border-color: var(--lime);
      box-shadow:
        0 0 0 1px rgba(200,255,0,0.2),
        0 20px 40px rgba(0,0,0,0.6),
        0 0 30px rgba(200,255,0,0.1);
    }
    .char-card:hover::before, .char-card:hover::after { opacity: 1; }

    .card-portrait {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
      transition: filter 0.3s ease;
    }
    .char-card:hover .card-portrait { filter: brightness(1.06); }

    /* ─── Portrait Crop Editor Modal ──────────────────────────────────── */
    #crop-modal {
      position: fixed;
      inset: 0;
      z-index: 900;
      display: none;
      align-items: center;
      justify-content: center;
      background: rgba(0,0,0,0.85);
      backdrop-filter: blur(8px);
    }
    #crop-modal.open { display: flex; }

    #crop-panel {
      background: var(--bg2);
      border: 1px solid var(--border);
      width: min(520px, 95vw);
      max-height: 92vh;
      overflow-y: auto;
      display: flex;
      flex-direction: column;
      animation: slideUp 0.25s cubic-bezier(0.34,1.2,0.64,1);
    }
    @keyframes slideUp {
      from { transform: translateY(30px); opacity: 0; }
      to   { transform: translateY(0);    opacity: 1; }
    }

    .crop-header {
      background: var(--bg3);
      border-bottom: 1px solid var(--border);
      padding: 0.75rem 1rem;
      display: flex;
      align-items: center;
      gap: 0.75rem;
      flex-shrink: 0;
    }
    .crop-title {
      font-family: var(--font-head);
      font-size: 0.8rem;
      letter-spacing: 0.2em;
      color: var(--cyan);
    }

    #crop-preview-wrap {
      position: relative;
      width: 160px;
      aspect-ratio: 2/5;
      overflow: hidden;
      border: 2px solid var(--border);
      background: var(--bg3);
      flex-shrink: 0;
      cursor: crosshair;
      user-select: none;
      touch-action: none;
    }
    #crop-preview-wrap::after {
      content: '';
      position: absolute;
      inset: 0;
      background:
        linear-gradient(rgba(200,255,0,0.12) 1px, transparent 1px) 0 33.33%/100% 33.33%,
        linear-gradient(90deg, rgba(200,255,0,0.12) 1px, transparent 1px) 33.33% 0/33.33% 100%;
      background-repeat: no-repeat;
      pointer-events: none;
      z-index: 2;
      border: 1px solid rgba(200,255,0,0.2);
    }
    #crop-preview-img,
    #crop-preview-video {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
      pointer-events: none;
    }

    .crop-slider-row { margin-bottom: 0.75rem; }
    .crop-slider-label {
      font-family: var(--font-mono);
      font-size: 0.65rem;
      color: var(--muted);
      letter-spacing: 0.1em;
      margin-bottom: 0.3rem;
      display: flex;
      justify-content: space-between;
    }
    .crop-slider {
      -webkit-appearance: none;
      appearance: none;
      width: 100%;
      height: 4px;
      background: var(--border);
      outline: none;
      cursor: pointer;
    }
    .crop-slider::-webkit-slider-thumb {
      -webkit-appearance: none;
      width: 16px; height: 16px;
      border-radius: 0;
      background: var(--lime);
      cursor: pointer;
      border: 2px solid #000;
    }
    .crop-slider::-moz-range-thumb {
      width: 16px; height: 16px;
      border-radius: 0;
      background: var(--lime);
      cursor: pointer;
      border: 2px solid #000;
    }

    .char-card-overlay {
      position: absolute;
      bottom: 0; left: 0; right: 0;
      background: linear-gradient(0deg, rgba(0,0,0,0.95) 0%, rgba(0,0,0,0.6) 60%, transparent 100%);
      padding: 2rem 0.8rem 0.7rem;
      z-index: 3;
    }

    .char-card-name {
      font-family: var(--font-head);
      font-size: clamp(0.65rem, 1.5vw, 0.85rem);
      font-weight: 700;
      letter-spacing: 0.15em;
      color: #fff;
      text-transform: uppercase;
    }

    .char-card-count {
      font-family: var(--font-mono);
      font-size: 0.6rem;
      color: var(--lime);
      letter-spacing: 0.1em;
    }

    /* NEW badge */
    .char-new-badge {
      position: absolute;
      top: 8px; right: 8px;
      background: var(--lime);
      color: #000;
      font-family: var(--font-mono);
      font-size: 0.55rem;
      font-weight: 700;
      letter-spacing: 0.1em;
      padding: 2px 6px;
      z-index: 4;
    }

    /* ─── Character Detail Modal ───────────────────────────────────────── */
    #detail-modal {
      position: fixed;
      inset: 0;
      background: rgba(10,10,12,0.96);
      z-index: 500;
      display: none;
      flex-direction: column;
      backdrop-filter: blur(4px);
    }
    #detail-modal.open { display: flex; }

    .detail-header {
      border-bottom: 1px solid var(--border);
      padding: 1rem 1.5rem;
      display: flex;
      align-items: center;
      gap: 1rem;
      background: var(--bg2);
      flex-shrink: 0;
    }

    .detail-char-name {
      font-family: var(--font-head);
      font-size: clamp(1rem, 3vw, 1.8rem);
      font-weight: 900;
      letter-spacing: 0.2em;
      color: var(--lime);
      text-shadow: 0 0 20px rgba(200,255,0,0.4);
      text-transform: uppercase;
    }

    .close-btn {
      margin-left: auto;
      background: transparent;
      border: 1px solid var(--border);
      color: var(--muted);
      font-family: var(--font-mono);
      font-size: 0.75rem;
      padding: 0.4rem 0.8rem;
      cursor: pointer;
      transition: all 0.2s;
      letter-spacing: 0.1em;
    }
    .close-btn:hover { border-color: var(--accent); color: var(--accent); }

    /* Masonry grid using CSS columns */
    .masonry-grid {
      columns: 2 200px;
      column-gap: 8px;
      padding: 1rem;
      overflow-y: auto;
      flex: 1;
    }
    @media (min-width: 640px)  { .masonry-grid { columns: 3 180px; } }
    @media (min-width: 1024px) { .masonry-grid { columns: 4 220px; column-gap: 10px; } }
    @media (min-width: 1440px) { .masonry-grid { columns: 5 220px; } }

    .masonry-item {
      break-inside: avoid;
      margin-bottom: 8px;
      position: relative;
      overflow: hidden;
      cursor: pointer;
      border: 1px solid var(--border);
      transition: border-color 0.2s;
    }
    @media (min-width: 1024px) { .masonry-item { margin-bottom: 10px; } }

    .masonry-item::after {
      content: '';
      position: absolute;
      inset: 0;
      background: rgba(200,255,0,0.0);
      transition: background 0.2s;
    }
    .masonry-item:hover::after { background: rgba(200,255,0,0.08); }
    .masonry-item:hover { border-color: var(--lime); }

    .masonry-item img,
    .masonry-item video {
      width: 100%;
      display: block;
      transition: transform 0.4s ease;
    }
    .masonry-item:hover img, .masonry-item:hover video { transform: scale(1.04); }

    /* ─── Fullscreen Viewer ────────────────────────────────────────────── */
    #fullscreen-viewer {
      position: fixed;
      inset: 0;
      background: rgba(0,0,0,0.97);
      z-index: 1000;
      display: none;
      align-items: center;
      justify-content: center;
      flex-direction: column;
    }
    #fullscreen-viewer.open { display: flex; }

    #fs-img {
      max-width: 95vw;
      max-height: 88vh;
      object-fit: contain;
      border: 1px solid var(--border);
      box-shadow: 0 20px 80px rgba(0,0,0,0.8);
      transition: opacity 0.2s ease;
    }

    #fullscreen-viewer video#fs-img {
      max-width: 92vw;
      max-height: 88vh;
      object-fit: contain;
      border: 1px solid var(--border);
      box-shadow: 0 0 60px rgba(0,0,0,0.8), 0 0 30px rgba(200,255,0,0.05);
      transition: opacity 0.2s;
    }
    #fs-img.fading { opacity: 0; }

    .fs-btn {
      position: fixed;
      top: 50%;
      transform: translateY(-50%);
      background: rgba(20,20,26,0.8);
      border: 1px solid var(--border);
      color: var(--text);
      font-family: var(--font-mono);
      font-size: 1.2rem;
      width: 48px;
      height: 80px;
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      transition: all 0.2s;
      backdrop-filter: blur(4px);
    }
    .fs-btn:hover { border-color: var(--lime); color: var(--lime); background: rgba(200,255,0,0.08); }
    #fs-prev { left: 12px; }
    #fs-next { right: 12px; }

    #fs-close {
      position: fixed;
      top: 16px;
      right: 16px;
      background: rgba(20,20,26,0.8);
      border: 1px solid var(--border);
      color: var(--text);
      font-family: var(--font-mono);
      font-size: 0.75rem;
      padding: 0.4rem 0.8rem;
      cursor: pointer;
      transition: all 0.2s;
      letter-spacing: 0.1em;
      backdrop-filter: blur(4px);
    }
    #fs-close:hover { border-color: var(--accent); color: var(--accent); }

    #fs-counter {
      position: fixed;
      bottom: 20px;
      left: 50%;
      transform: translateX(-50%);
      font-family: var(--font-mono);
      font-size: 0.7rem;
      color: var(--muted);
      letter-spacing: 0.2em;
    }

    /* ─── Edit Modal ───────────────────────────────────────────────────── */
    #edit-modal {
      position: fixed;
      inset: 0;
      z-index: 800;
      display: none;
      align-items: flex-start;
      justify-content: flex-end;
      pointer-events: none;
    }
    #edit-modal.open { display: flex; }

    #edit-panel {
      pointer-events: all;
      width: min(480px, 95vw);
      height: 100vh;
      background: var(--bg2);
      border-left: 1px solid var(--border);
      display: flex;
      flex-direction: column;
      font-family: var(--font-body);
      overflow: hidden;
      animation: slideIn 0.25s cubic-bezier(0.34,1.2,0.64,1);
    }
    @keyframes slideIn {
      from { transform: translateX(100%); opacity: 0; }
      to   { transform: translateX(0);    opacity: 1; }
    }

    .edit-header {
      background: var(--bg3);
      border-bottom: 1px solid var(--border);
      padding: 1rem 1.2rem;
      display: flex;
      align-items: center;
      gap: 0.75rem;
      flex-shrink: 0;
    }
    .edit-title {
      font-family: var(--font-head);
      font-size: 0.85rem;
      letter-spacing: 0.2em;
      color: var(--lime);
      text-transform: uppercase;
    }
    .edit-badge {
      font-family: var(--font-mono);
      font-size: 0.55rem;
      background: rgba(200,255,0,0.15);
      color: var(--lime);
      border: 1px solid rgba(200,255,0,0.3);
      padding: 2px 6px;
      letter-spacing: 0.15em;
    }

    .edit-body { overflow-y: auto; flex: 1; padding: 1rem; }

    .edit-section {
      margin-bottom: 1.5rem;
    }
    .edit-section-title {
      font-family: var(--font-mono);
      font-size: 0.65rem;
      color: var(--muted);
      letter-spacing: 0.2em;
      text-transform: uppercase;
      margin-bottom: 0.6rem;
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }
    .edit-section-title::after {
      content: '';
      flex: 1;
      height: 1px;
      background: var(--border);
    }

    .edit-input {
      background: var(--bg3);
      border: 1px solid var(--border);
      color: var(--text);
      font-family: var(--font-body);
      font-size: 0.875rem;
      padding: 0.5rem 0.75rem;
      width: 100%;
      outline: none;
      transition: border-color 0.2s;
    }
    .edit-input:focus { border-color: var(--lime); }
    .edit-input::placeholder { color: var(--muted); }

    .edit-btn {
      font-family: var(--font-mono);
      font-size: 0.7rem;
      letter-spacing: 0.1em;
      padding: 0.5rem 1rem;
      border: 1px solid;
      cursor: pointer;
      transition: all 0.2s;
      text-transform: uppercase;
    }
    .edit-btn-lime {
      border-color: var(--lime);
      color: var(--lime);
      background: rgba(200,255,0,0.05);
    }
    .edit-btn-lime:hover { background: var(--lime); color: #000; }
    .edit-btn-red {
      border-color: #ff4444;
      color: #ff4444;
      background: rgba(255,68,68,0.05);
    }
    .edit-btn-red:hover { background: #ff4444; color: #fff; }
    .edit-btn-cyan {
      border-color: var(--cyan);
      color: var(--cyan);
      background: rgba(0,245,212,0.05);
    }
    .edit-btn-cyan:hover { background: var(--cyan); color: #000; }

    .char-edit-row {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      padding: 0.4rem 0.5rem;
      border: 1px solid var(--border);
      margin-bottom: 0.4rem;
      background: var(--bg3);
      cursor: pointer;
      transition: border-color 0.2s;
    }
    .char-edit-row:hover { border-color: var(--lime); }
    .char-edit-row.selected { border-color: var(--lime); background: rgba(200,255,0,0.05); }

    .char-edit-thumb {
      width: 32px;
      height: 40px;
      object-fit: cover;
      object-position: top;
      border: 1px solid var(--border);
      flex-shrink: 0;
    }
    .char-edit-name {
      font-family: var(--font-body);
      font-size: 0.85rem;
      font-weight: 600;
      flex: 1;
    }

    .img-edit-row {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      padding: 0.3rem 0.4rem;
      border: 1px solid var(--border);
      margin-bottom: 0.3rem;
      background: var(--bg3);
    }
    .img-edit-thumb {
      width: 40px;
      height: 30px;
      object-fit: cover;
      border: 1px solid var(--border);
      flex-shrink: 0;
    }
    .img-edit-url {
      font-family: var(--font-mono);
      font-size: 0.6rem;
      color: var(--muted);
      flex: 1;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    /* ─── Empty State ──────────────────────────────────────────────────── */
    .empty-state {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      padding: 4rem 2rem;
      color: var(--muted);
      text-align: center;
    }
    .empty-icon {
      font-size: 3rem;
      margin-bottom: 1rem;
      opacity: 0.3;
    }

    /* ─── Loading Skeleton ─────────────────────────────────────────────── */
    .skeleton {
      background: linear-gradient(90deg, var(--bg3) 25%, var(--bg2) 50%, var(--bg3) 75%);
      background-size: 200% 100%;
      animation: shimmer 1.5s infinite;
    }
    @keyframes shimmer {
      0%   { background-position: 200% 0; }
      100% { background-position: -200% 0; }
    }

    /* ─── Scrollbar ────────────────────────────────────────────────────── */
    ::-webkit-scrollbar { width: 6px; height: 6px; }
    ::-webkit-scrollbar-track { background: var(--bg); }
    ::-webkit-scrollbar-thumb { background: var(--border); }
    ::-webkit-scrollbar-thumb:hover { background: var(--muted); }

    /* ─── Toast Notification ───────────────────────────────────────────── */
    #toast {
      position: fixed;
      bottom: 24px;
      left: 50%;
      transform: translateX(-50%) translateY(80px);
      background: var(--bg3);
      border: 1px solid var(--lime);
      color: var(--lime);
      font-family: var(--font-mono);
      font-size: 0.7rem;
      letter-spacing: 0.1em;
      padding: 0.5rem 1.2rem;
      z-index: 9000;
      transition: transform 0.3s cubic-bezier(0.34,1.56,0.64,1);
      pointer-events: none;
    }
    #toast.show { transform: translateX(-50%) translateY(0); }

    .corner-br {
      position: absolute;
      bottom: 0; right: 0;
      width: 18px; height: 18px;
      border-bottom: 2px solid var(--lime);
      border-right: 2px solid var(--lime);
      pointer-events: none;
    }

    /* ─── Status bar ───────────────────────────────────────────────────── */
    #status-bar {
      font-family: var(--font-mono);
      font-size: 0.6rem;
      color: var(--muted);
      letter-spacing: 0.15em;
      border-top: 1px solid var(--border);
      padding: 0.25rem 1rem;
      display: flex;
      gap: 2rem;
      background: var(--bg2);
    }
    .status-dot {
      display: inline-block;
      width: 6px; height: 6px;
      border-radius: 50%;
      background: var(--lime);
      margin-right: 0.4rem;
      animation: pulse 2s infinite;
    }
    @keyframes pulse {
      0%, 100% { opacity: 1; }
      50% { opacity: 0.3; }
    }

    /* Responsive grid for cards */
    #char-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 8px;
      padding: 1rem;
    }
    @media (min-width: 480px)  { #char-grid { grid-template-columns: repeat(3, 1fr); gap: 10px; } }
    @media (min-width: 768px)  { #char-grid { grid-template-columns: repeat(4, 1fr); gap: 12px; } }
    @media (min-width: 1024px) { #char-grid { grid-template-columns: repeat(5, 1fr); gap: 14px; } }
    @media (min-width: 1440px) { #char-grid { grid-template-columns: repeat(6, 1fr); gap: 16px; padding: 1.5rem; } }

    .kbd {
      display: inline-block;
      background: var(--bg3);
      border: 1px solid var(--border);
      color: var(--muted);
      font-family: var(--font-mono);
      font-size: 0.55rem;
      padding: 2px 5px;
      letter-spacing: 0.1em;
    }

    /* ════════════════════════════════════════════════════════════════════
       CHARACTER CHOICE POPUP
    ════════════════════════════════════════════════════════════════════ */
    #char-choice-overlay {
      position: fixed;
      inset: 0;
      background: rgba(0,0,0,0.88);
      backdrop-filter: blur(10px);
      z-index: 600;
      display: none;
      align-items: center;
      justify-content: center;
    }
    #char-choice-overlay.open { display: flex; }

    .char-choice-popup {
      background: var(--bg2);
      border: 1px solid var(--lime);
      box-shadow: 0 0 40px rgba(200,255,0,0.1), 0 24px 60px rgba(0,0,0,0.9);
      width: min(300px, 90vw);
      display: flex;
      flex-direction: column;
      align-items: center;
      padding: 1.5rem 1.5rem 1rem;
      gap: 1rem;
      animation: slideUp 0.22s cubic-bezier(0.34,1.2,0.64,1);
    }

    .choice-portrait-wrap {
      width: 100px;
      aspect-ratio: 2/5;
      overflow: hidden;
      border: 1px solid var(--border);
      position: relative;
      flex-shrink: 0;
    }
    .choice-portrait {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }

    .choice-char-name {
      font-family: var(--font-head);
      font-size: 0.9rem;
      font-weight: 700;
      letter-spacing: 0.2em;
      color: var(--lime);
      text-transform: uppercase;
      text-align: center;
      text-shadow: 0 0 16px rgba(200,255,0,0.4);
    }

    .choice-subtitle {
      font-family: var(--font-mono);
      font-size: 0.58rem;
      color: var(--muted);
      letter-spacing: 0.12em;
      margin-top: -0.5rem;
      text-align: center;
    }

    .choice-btn-row {
      display: flex;
      gap: 0.6rem;
      width: 100%;
    }

    .choice-btn {
      flex: 1;
      font-family: var(--font-mono);
      font-size: 0.65rem;
      letter-spacing: 0.12em;
      padding: 0.65rem 0;
      border: 1px solid;
      cursor: pointer;
      transition: all 0.18s;
      text-transform: uppercase;
      background: transparent;
    }
    .choice-btn-gallery { border-color: var(--cyan); color: var(--cyan); }
    .choice-btn-gallery:hover { background: var(--cyan); color: #000; }
    .choice-btn-chat { border-color: var(--lime); color: var(--lime); }
    .choice-btn-chat:hover { background: var(--lime); color: #000; }

    .choice-close-btn {
      font-family: var(--font-mono);
      font-size: 0.58rem;
      color: var(--muted);
      background: none;
      border: none;
      cursor: pointer;
      letter-spacing: 0.1em;
      padding: 0;
      transition: color 0.15s;
    }
    .choice-close-btn:hover { color: var(--accent); }

    /* ════════════════════════════════════════════════════════════════════
       CHAT MODAL
    ════════════════════════════════════════════════════════════════════ */
    #chat-modal {
      position: fixed;
      inset: 0;
      z-index: 550;
      display: none;
      flex-direction: column;
      background: var(--bg);
    }
    #chat-modal.open { display: flex; }

    /* Chat header */
    .chat-modal-hdr {
      background: var(--bg2);
      border-bottom: 1px solid var(--border);
      padding: 0.6rem 1rem;
      display: flex;
      align-items: center;
      gap: 0.6rem;
      flex-shrink: 0;
      min-height: 50px;
    }
    .chat-modal-hdr-name {
      font-family: var(--font-head);
      font-size: clamp(0.75rem, 2vw, 1rem);
      font-weight: 700;
      letter-spacing: 0.15em;
      color: var(--lime);
      text-shadow: 0 0 14px rgba(200,255,0,0.3);
      text-transform: uppercase;
    }
    .chat-modal-hdr-sub {
      font-family: var(--font-mono);
      font-size: 0.58rem;
      color: var(--muted);
      letter-spacing: 0.1em;
    }

    /* Model bar */
    .chat-model-bar {
      background: var(--bg3);
      border-bottom: 1px solid var(--border);
      padding: 0.35rem 1rem;
      display: flex;
      align-items: center;
      gap: 0.65rem;
      flex-shrink: 0;
      font-family: var(--font-mono);
      font-size: 0.6rem;
      color: var(--muted);
      letter-spacing: 0.1em;
    }
    .chat-model-sel {
      background: var(--bg3);
      border: 1px solid var(--border);
      color: var(--text);
      font-family: var(--font-mono);
      font-size: 0.6rem;
      padding: 0.18rem 0.45rem;
      outline: none;
      cursor: pointer;
      transition: border-color 0.15s;
      letter-spacing: 0.05em;
    }
    .chat-model-sel:focus { border-color: var(--lime); }

    .chat-conn-dot {
      width: 6px; height: 6px;
      border-radius: 50%;
      flex-shrink: 0;
    }
    .chat-conn-dot.online { background: #4ade80; box-shadow: 0 0 5px rgba(74,222,128,0.6); }
    .chat-conn-dot.offline { background: var(--accent); }

    /* Body */
    .chat-modal-body {
      flex: 1;
      display: flex;
      min-height: 0;
      overflow: hidden;
    }

    /* Messages area */
    .chat-msgs-wrap {
      flex: 1;
      display: flex;
      flex-direction: column;
      min-height: 0;
      position: relative;
    }

    .chat-msgs {
      flex: 1;
      overflow-y: auto;
      padding: 1.2rem 1rem;
      display: flex;
      flex-direction: column;
      gap: 0.9rem;
    }

    /* Individual messages */
    .cmsg {
      display: flex;
      gap: 0.5rem;
      max-width: 82%;
      animation: fadeUp 0.18s ease;
    }
    @keyframes fadeUp { from{opacity:0;transform:translateY(5px)} to{opacity:1;transform:translateY(0)} }

    .cmsg-user {
      align-self: flex-end;
      flex-direction: column;
      align-items: flex-end;
    }
    .cmsg-assistant {
      align-self: flex-start;
    }

    .cmsg-name {
      font-family: var(--font-mono);
      font-size: 0.56rem;
      color: var(--muted);
      letter-spacing: 0.12em;
      margin-bottom: 0.18rem;
      text-transform: uppercase;
    }
    .cmsg-user .cmsg-name { text-align: right; }

    .cmsg-av {
      width: 26px; height: 26px;
      background: var(--bg3);
      border: 1px solid var(--border);
      display: flex;
      align-items: center;
      justify-content: center;
      font-family: var(--font-head);
      font-size: 0.52rem;
      color: var(--lime);
      flex-shrink: 0;
      margin-top: 1px;
      text-transform: uppercase;
    }

    .cmsg-bubble {
      padding: 0.55rem 0.85rem;
      font-family: var(--font-chat);
      font-size: 0.92rem;
      line-height: 1.65;
      word-break: break-word;
      white-space: pre-wrap;
    }
    .cmsg-bubble-user {
      background: var(--lime);
      color: #000;
      font-weight: 600;
      border-bottom-right-radius: 2px;
    }
    .cmsg-bubble-assistant {
      background: var(--bg3);
      border: 1px solid var(--border);
      color: var(--text);
      border-bottom-left-radius: 2px;
    }

    /* Typing indicator */
    .chat-typing {
      display: flex;
      gap: 4px;
      padding: 0.55rem 0.85rem;
      align-items: center;
      min-height: 36px;
    }
    .chat-typing span {
      width: 6px; height: 6px;
      border-radius: 50%;
      background: var(--muted);
      animation: cDot 1.2s infinite ease-in-out;
    }
    .chat-typing span:nth-child(2) { animation-delay: 0.18s; }
    .chat-typing span:nth-child(3) { animation-delay: 0.36s; }
    @keyframes cDot {
      0%,80%,100% { transform: scale(0.7); opacity: 0.4; }
      40% { transform: scale(1.1); background: var(--lime); opacity: 1; }
    }

    /* Streaming cursor */
    .chat-streaming::after {
      content: '▍';
      animation: cBlink 0.65s infinite;
      color: var(--lime);
      margin-left: 1px;
      font-size: 0.78em;
    }
    @keyframes cBlink { 0%,100%{opacity:1} 50%{opacity:0} }

    /* *action text* styling */
    .chat-action-text { color: var(--muted); font-style: italic; }

    /* ─── Chat Right Panel ─────────────────────────────────────────────── */
    .chat-right {
      width: 210px;
      border-left: 1px solid var(--border);
      background: var(--bg2);
      display: flex;
      flex-direction: column;
      overflow-y: auto;
      flex-shrink: 0;
      transition: width 0.2s, opacity 0.2s;
    }
    .chat-right.hidden { display: none; }
    @media (max-width: 640px) { .chat-right { display: none !important; } }

    .crp-portrait-wrap { position: relative; }
    .crp-portrait {
      width: 100%;
      aspect-ratio: 2/5;
      object-fit: cover;
      display: block;
      background: var(--bg3);
    }
    .crp-portrait-ph {
      width: 100%;
      aspect-ratio: 2/5;
      background: var(--bg3);
      display: flex;
      align-items: center;
      justify-content: center;
      font-family: var(--font-head);
      font-size: 3rem;
      color: var(--border);
    }
    .crp-grad {
      position: absolute;
      bottom: 0; left: 0; right: 0;
      height: 60px;
      background: linear-gradient(to top, var(--bg2) 0%, transparent 100%);
    }
    .crp-body { padding: 0.75rem; }
    .crp-name {
      font-family: var(--font-head);
      font-size: 0.78rem;
      font-weight: 700;
      letter-spacing: 0.15em;
      color: var(--lime);
      text-transform: uppercase;
      margin-bottom: 0.3rem;
    }
    .crp-count {
      font-family: var(--font-mono);
      font-size: 0.56rem;
      color: var(--muted);
      letter-spacing: 0.1em;
      margin-bottom: 0.6rem;
    }
    .crp-section-title {
      font-family: var(--font-mono);
      font-size: 0.55rem;
      color: var(--muted);
      letter-spacing: 0.15em;
      text-transform: uppercase;
      margin-bottom: 0.25rem;
    }
    .crp-story {
      font-family: var(--font-chat);
      font-size: 0.73rem;
      color: var(--text);
      line-height: 1.6;
      opacity: 0.75;
      margin-bottom: 0.75rem;
      display: -webkit-box;
      -webkit-line-clamp: 6;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }
    .crp-divider {
      border: none;
      border-top: 1px solid var(--border);
      margin: 0.5rem 0;
    }
    .crp-btn {
      width: 100%;
      font-family: var(--font-mono);
      font-size: 0.58rem;
      letter-spacing: 0.1em;
      padding: 0.4rem;
      border: 1px solid var(--border);
      color: var(--muted);
      background: transparent;
      cursor: pointer;
      transition: all 0.15s;
      margin-bottom: 0.35rem;
      text-transform: uppercase;
    }
    .crp-btn:hover { border-color: var(--lime); color: var(--lime); }
    .crp-btn.red:hover { border-color: var(--accent); color: var(--accent); }

    /* ─── Chat Input Area ──────────────────────────────────────────────── */
    .chat-input-zone {
      background: var(--bg2);
      border-top: 1px solid var(--border);
      padding: 0.7rem 1rem 0.55rem;
      flex-shrink: 0;
    }
    .chat-input-wrap {
      display: flex;
      gap: 0.45rem;
      align-items: flex-end;
      background: var(--bg3);
      border: 1px solid var(--border);
      padding: 0.4rem 0.4rem 0.4rem 0.7rem;
      transition: border-color 0.2s, box-shadow 0.2s;
    }
    .chat-input-wrap:focus-within {
      border-color: var(--lime);
      box-shadow: 0 0 0 2px rgba(200,255,0,0.08);
    }
    .chat-textarea {
      flex: 1;
      background: none;
      border: none;
      color: var(--text);
      font-family: var(--font-chat);
      font-size: 0.9rem;
      resize: none;
      outline: none;
      line-height: 1.5;
      max-height: 100px;
      padding: 2px 0;
    }
    .chat-textarea::placeholder { color: var(--muted); font-family: var(--font-mono); font-size: 0.75rem; letter-spacing: 0.05em; }
    .chat-send-btn {
      background: var(--lime);
      border: none;
      color: #000;
      width: 30px; height: 30px;
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      flex-shrink: 0;
      transition: background 0.15s, transform 0.1s;
    }
    .chat-send-btn:hover { background: var(--lime2); }
    .chat-send-btn:active { transform: scale(0.9); }
    .chat-send-btn:disabled { opacity: 0.3; cursor: not-allowed; transform: none; }
    .chat-send-btn svg { width: 12px; height: 12px; }

    .chat-input-hint {
      font-family: var(--font-mono);
      font-size: 0.52rem;
      color: var(--muted);
      letter-spacing: 0.08em;
      text-align: center;
      margin-top: 0.3rem;
    }

    /* AI Persona fields in edit panel */
    .ai-field-label {
      font-family: var(--font-mono);
      font-size: 0.6rem;
      color: var(--muted);
      letter-spacing: 0.12em;
      text-transform: uppercase;
      margin-bottom: 0.25rem;
      margin-top: 0.5rem;
    }
    .ai-field-label:first-child { margin-top: 0; }
  </style>
</head>
<body>

  <!-- ═══════════════════════════════ HEADER ════════════════════════════════ -->
  <header id="main-header">
    <div style="padding: 0.75rem 1rem; display: flex; align-items: center; gap: 1rem; flex-wrap: wrap;">

      <!-- Gallery label -->
      <div class="header-gallery-label">GALLERY</div>

      <!-- Search -->
      <div style="position: relative; flex: 1; min-width: 180px; max-width: 320px;">
        <svg style="position:absolute;left:0.6rem;top:50%;transform:translateY(-50%);width:14px;height:14px;color:var(--muted);" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="11" cy="11" r="8"/><path d="M21 21l-4.35-4.35"/></svg>
        <input id="search-input" type="text" placeholder="SEARCH CHARACTER..." />
      </div>

      <!-- Spacer -->
      <div style="flex:1;"></div>

      <!-- Edit hint -->
      <span style="font-family:var(--font-mono);font-size:0.6rem;color:var(--muted);letter-spacing:0.1em;">
        <span class="kbd">F4</span> EDIT
      </span>

      <!-- Unlock button (cosmetic) -->
      <button class="unlock-btn" onclick="showToast('✦ ALL SCENES UNLOCKED ✦')">
        ✦ UNLOCK ALL H-SCENES
      </button>
    </div>

    <!-- Status bar -->
    <div id="status-bar">
      <span><span class="status-dot"></span>SYSTEM ONLINE</span>
      <span id="status-count">0 CHARACTERS LOADED</span>
      <span id="status-db">DB: INITIALIZING...</span>
      <span style="margin-left:auto;" id="status-time"></span>
    </div>
  </header>

  <!-- ═══════════════════════════════ MAIN GRID ══════════════════════════════ -->
  <main>
    <div id="char-grid">
      <!-- Cards rendered by JS -->
    </div>
    <div id="empty-state" class="empty-state" style="display:none;">
      <div class="empty-icon">◈</div>
      <div style="font-family:var(--font-head);font-size:0.9rem;letter-spacing:0.2em;color:var(--muted);">NO CHARACTERS FOUND</div>
      <div style="font-family:var(--font-mono);font-size:0.65rem;color:var(--muted);margin-top:0.5rem;">PRESS F4 TO ADD CHARACTERS</div>
    </div>
  </main>

  <!-- ═══════════════════════════════ DETAIL MODAL ══════════════════════════ -->
  <div id="detail-modal">
    <div class="detail-header">
      <div>
        <div style="font-family:var(--font-mono);font-size:0.6rem;color:var(--muted);letter-spacing:0.2em;margin-bottom:0.2rem;">CHARACTER FILE</div>
        <div class="detail-char-name" id="detail-char-name">CHARACTER NAME</div>
      </div>
      <div id="detail-img-count" style="font-family:var(--font-mono);font-size:0.65rem;color:var(--lime);border:1px solid rgba(200,255,0,0.3);padding:4px 10px;margin-left:0.5rem;"></div>
      <button class="close-btn" onclick="closeDetailModal()">[ ESC ] CLOSE</button>
    </div>
    <div class="masonry-grid" id="detail-grid">
      <!-- Masonry images rendered by JS -->
    </div>
  </div>

  <!-- ═══════════════════════════════ FULLSCREEN VIEWER ═══════════════════════ -->
  <div id="fullscreen-viewer">
    <button class="fs-btn" id="fs-prev" onclick="fsNavigate(-1)">&#8249;</button>
    <img id="fs-img" src="" alt="" />
    <button class="fs-btn" id="fs-next" onclick="fsNavigate(1)">&#8250;</button>
    <button id="fs-close" onclick="closeFullscreen()">[ ESC ] CLOSE</button>
    <div id="fs-counter">0 / 0</div>
  </div>

  <!-- ═══════════════════════════════ EDIT MODAL (F4) ═══════════════════════ -->
  <div id="edit-modal">
    <div id="edit-panel">
      <div class="edit-header">
        <span class="edit-title">ADMIN PANEL</span>
        <span class="edit-badge">F4</span>
        <button class="close-btn" style="margin-left:auto;" onclick="toggleEditModal()">CLOSE ×</button>
      </div>

      <div class="edit-body">

        <!-- Add Character -->
        <div class="edit-section">
          <div class="edit-section-title">ADD CHARACTER</div>
          <div style="display:flex;flex-direction:column;gap:0.4rem;">
            <input class="edit-input" id="new-char-name" type="text" placeholder="Character Name" />
            <input class="edit-input" id="new-char-portrait" type="text" placeholder="Portrait Image URL" />
            <button class="edit-btn edit-btn-lime" onclick="addCharacter()">+ ADD CHARACTER</button>
          </div>
        </div>

        <!-- Character List -->
        <div class="edit-section">
          <div class="edit-section-title">CHARACTERS</div>
          <div id="edit-char-list"><!-- rendered by JS --></div>
        </div>

        <!-- Selected Character Editor -->
        <div class="edit-section" id="edit-selected-section" style="display:none;">
          <div class="edit-section-title" id="edit-selected-title">EDIT CHARACTER</div>

          <!-- Basic info -->
          <div style="display:flex;flex-direction:column;gap:0.4rem;margin-bottom:0.75rem;">
            <input class="edit-input" id="edit-char-name" type="text" placeholder="Character Name" />
            <input class="edit-input" id="edit-char-portrait" type="text" placeholder="Portrait URL (image or .mp4)" />
            <input class="edit-input" id="edit-char-portrait-file" type="file" accept="image/*,video/mp4" onchange="uploadPortraitFile(event)" />
            <div style="display:flex;gap:0.4rem;">
              <button class="edit-btn edit-btn-lime" style="flex:1;" onclick="saveCharacterEdit()">SAVE</button>
              <button class="edit-btn edit-btn-cyan" onclick="openCropModal()">⊹ CROP</button>
              <button class="edit-btn edit-btn-red" onclick="deleteCharacter()">DELETE</button>
            </div>
          </div>

          <!-- AI PERSONA section -->
          <div style="margin-bottom:0.9rem;background:rgba(200,255,0,0.02);border:1px solid rgba(200,255,0,0.08);padding:0.75rem;">
            <div style="font-family:var(--font-mono);font-size:0.62rem;color:var(--lime);letter-spacing:0.18em;margin-bottom:0.65rem;opacity:0.9;">✦ AI PERSONA</div>

            <div class="ai-field-label">STORY / BACKSTORY</div>
            <textarea class="edit-input" id="edit-ai-story" rows="4"
              placeholder="Character background, world, history, motivations..."
              style="resize:vertical;font-family:var(--font-chat);font-size:0.82rem;line-height:1.5;"></textarea>

            <div class="ai-field-label">PERSONALITY &amp; VOICE</div>
            <textarea class="edit-input" id="edit-ai-personality" rows="4"
              placeholder="Tone, speech patterns, quirks, values, how they react..."
              style="resize:vertical;font-family:var(--font-chat);font-size:0.82rem;line-height:1.5;"></textarea>

            <div class="ai-field-label">GREETING MESSAGE</div>
            <textarea class="edit-input" id="edit-ai-greeting" rows="2"
              placeholder="First message shown when a new chat starts..."
              style="resize:vertical;font-family:var(--font-chat);font-size:0.82rem;line-height:1.5;"></textarea>

            <div class="ai-field-label">CHAT BACKGROUND IMAGE URL</div>
            <input class="edit-input" id="edit-bg-image" type="text"
              placeholder="https://example.com/scene.jpg" />
            <div style="font-family:var(--font-mono);font-size:0.55rem;color:var(--muted);margin-top:0.3rem;line-height:1.5;">
              Shown behind messages in chat view. Any image URL works.
            </div>
          </div>

          <!-- Add Images -->
          <div style="margin-bottom:0.75rem;">
            <div style="font-family:var(--font-mono);font-size:0.65rem;color:var(--muted);letter-spacing:0.1em;margin-bottom:0.4rem;">ADD GALLERY MEDIA (one URL per line, image or .mp4)</div>
