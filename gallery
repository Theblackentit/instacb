  ══════════════════════════════════════════════════════════════════════════ */

  let cropCharId  = null;
  let cropOX      = 50;
  let cropOY      = 20;
  let cropScale   = 1.0;
  let cropDragging   = false;
  let cropDragStartX = 0;
  let cropDragStartY = 0;
  let cropDragOX0    = 50;
  let cropDragOY0    = 20;

  function openCropModal() {
    if (!selectedCharId) return showToast('⚠ Select a character first');
    const char = allCharacters.find(c => c.id === selectedCharId);
    if (!char) return;

    cropCharId = selectedCharId;
    cropOX     = char.portraitOffsetX ?? 50;
    cropOY     = char.portraitOffsetY ?? 20;
    cropScale  = char.portraitScale   ?? 1.0;

