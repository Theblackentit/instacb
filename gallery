  <!-- ═══════════════════════════════ JAVASCRIPT ════════════════════════════ -->
  <script>
  'use strict';

  /* ══════════════════════════════════════════════════════════════════════════
     IndexedDB Setup
     Database: AnimeGalleryDB  v3
     Stores:
       - characters: { id (auto), name, portraitUrl, order,
                       portraitOffsetX/Y/Scale,
                       aiStory, aiPersonality, aiGreeting, backgroundImage }
       - images:     { id (auto), characterId, imageUrl, order }
       - chatConvos: { id (string), characterId, messages[], createdAt, updatedAt }
  ══════════════════════════════════════════════════════════════════════════ */

  const DB_NAME    = 'AnimeGalleryDB';
  const DB_VERSION = 3;
  let   db         = null;

  function openDB() {
    return new Promise((resolve, reject) => {
      const req = indexedDB.open(DB_NAME, DB_VERSION);

      req.onupgradeneeded = (e) => {
        const database = e.target.result;

        if (!database.objectStoreNames.contains('characters')) {
          const cs = database.createObjectStore('characters', { keyPath: 'id', autoIncrement: true });
          cs.createIndex('order', 'order', { unique: false });
        }

        if (!database.objectStoreNames.contains('images')) {
          const is = database.createObjectStore('images', { keyPath: 'id', autoIncrement: true });
          is.createIndex('characterId', 'characterId', { unique: false });
          is.createIndex('order', 'order', { unique: false });
        }

        if (!database.objectStoreNames.contains('chatConvos')) {
          const cvs = database.createObjectStore('chatConvos', { keyPath: 'id' });
          cvs.createIndex('characterId', 'characterId', { unique: false });
        }
      };

      req.onsuccess = (e) => resolve(e.target.result);
      req.onerror   = (e) => reject(e.target.error);
    });
  }

  function promisifyRequest(req) {
    return new Promise((resolve, reject) => {
      req.onsuccess = (e) => resolve(e.target.result);
      req.onerror   = (e) => reject(e.target.error);
    });
  }

  /* ── CRUD: Characters ─────────────────────────────────────────────────── */

  async function getAllCharacters() {
    const tx    = db.transaction('characters', 'readonly');
    const store = tx.objectStore('characters');
    const all   = await promisifyRequest(store.getAll());
    return all.sort((a, b) => (a.order ?? a.id) - (b.order ?? b.id));
  }

  async function addCharacterToDB(name, portraitUrl) {
    const all   = await getAllCharacters();
    const order = all.length;
    const tx    = db.transaction('characters', 'readwrite');
    const store = tx.objectStore('characters');
    return promisifyRequest(store.add({ name, portraitUrl, order }));
  }

  async function updateCharacterInDB(id, name, portraitUrl) {
    const tx    = db.transaction('characters', 'readwrite');
    const store = tx.objectStore('characters');
    const existing = await promisifyRequest(store.get(id));
    if (!existing) throw new Error('Character not found');
    existing.name        = name;
    existing.portraitUrl = portraitUrl;
    return promisifyRequest(store.put(existing));
  }

  async function updateCharacterAIData(id, aiStory, aiPersonality, aiGreeting, backgroundImage) {
    const tx    = db.transaction('characters', 'readwrite');
    const store = tx.objectStore('characters');
    const existing = await promisifyRequest(store.get(id));
    if (!existing) throw new Error('Character not found');
    existing.aiStory        = aiStory;
    existing.aiPersonality  = aiPersonality;
    existing.aiGreeting     = aiGreeting;
    existing.backgroundImage = backgroundImage;
    return promisifyRequest(store.put(existing));
  }

  async function savePortraitCrop(id, offsetX, offsetY, scale) {
    const tx    = db.transaction('characters', 'readwrite');
    const store = tx.objectStore('characters');
    const existing = await promisifyRequest(store.get(id));
    if (!existing) throw new Error('Character not found');
    existing.portraitOffsetX = offsetX;
    existing.portraitOffsetY = offsetY;
    existing.portraitScale   = scale;
    return promisifyRequest(store.put(existing));
  }

  async function deleteCharacterFromDB(id) {
    const tx1    = db.transaction('characters', 'readwrite');
    const store1 = tx1.objectStore('characters');
    await promisifyRequest(store1.delete(id));

    const images = await getImagesByCharacter(id);
    if (images.length > 0) {
      const tx2    = db.transaction('images', 'readwrite');
      const store2 = tx2.objectStore('images');
      for (const img of images) {
        await promisifyRequest(store2.delete(img.id));
      }
    }

    // Delete chat convos for this character
    const convos = await getChatConvosByCharacter(id);
    if (convos.length > 0) {
      const tx3    = db.transaction('chatConvos', 'readwrite');
      const store3 = tx3.objectStore('chatConvos');
      for (const cv of convos) await promisifyRequest(store3.delete(cv.id));
    }
  }

  /* ── CRUD: Images ─────────────────────────────────────────────────────── */

  async function getImagesByCharacter(characterId) {
    const tx    = db.transaction('images', 'readonly');
    const store = tx.objectStore('images');
    const index = store.index('characterId');
    const all   = await promisifyRequest(index.getAll(characterId));
    return all.sort((a, b) => (a.order ?? a.id) - (b.order ?? b.id));
  }

  async function addImageToDB(characterId, imageUrl) {
    const existing = await getImagesByCharacter(characterId);
    const order    = existing.length;
    const tx       = db.transaction('images', 'readwrite');
    const store    = tx.objectStore('images');
    return promisifyRequest(store.add({ characterId, imageUrl, order }));
  }

  async function deleteImageFromDB(id) {
    const tx    = db.transaction('images', 'readwrite');
    const store = tx.objectStore('images');
    return promisifyRequest(store.delete(id));
  }

  async function countAllImages() {
    const tx    = db.transaction('images', 'readonly');
    const store = tx.objectStore('images');
    return promisifyRequest(store.count());
  }

  /* ── CRUD: Chat Conversations ─────────────────────────────────────────── */

  async function getChatConvosByCharacter(characterId) {
    const tx    = db.transaction('chatConvos', 'readonly');
    const store = tx.objectStore('chatConvos');
    const index = store.index('characterId');
    const all   = await promisifyRequest(index.getAll(characterId));
    return all.sort((a, b) => b.updatedAt - a.updatedAt);
  }

  async function putChatConvo(convo) {
    const tx    = db.transaction('chatConvos', 'readwrite');
    const store = tx.objectStore('chatConvos');
    return promisifyRequest(store.put(convo));
  }

  async function deleteChatConvoDB(id) {
    const tx    = db.transaction('chatConvos', 'readwrite');
    const store = tx.objectStore('chatConvos');
    return promisifyRequest(store.delete(id));
  }

  function chatUid() {
    return Math.random().toString(36).slice(2, 9) + Date.now().toString(36);
  }

  /* ══════════════════════════════════════════════════════════════════════════
