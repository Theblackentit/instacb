  function syncCropUI() {
    document.getElementById('crop-ox').value = cropOX;
    document.getElementById('crop-oy').value = cropOY;
    document.getElementById('crop-sc').value = Math.round(cropScale * 100);

    document.getElementById('crop-ox-val').textContent = Math.round(cropOX) + '%';
    document.getElementById('crop-oy-val').textContent = Math.round(cropOY) + '%';
    document.getElementById('crop-sc-val').textContent = cropScale.toFixed(2) + '×';

    applyCropToPreview();
  }

  function applyCropToPreview() {
    const target = document.getElementById('crop-preview-video').style.display !== 'none'
      ? document.getElementById('crop-preview-video')
      : document.getElementById('crop-preview-img');
    target.style.objectPosition = cropOX + '% ' + cropOY + '%';
    target.style.transform      = 'scale(' + cropScale + ')';
    target.style.transformOrigin = cropOX + '% ' + cropOY + '%';
  }

  function cropUpdateFromSliders() {
    cropOX    = parseFloat(document.getElementById('crop-ox').value);
    cropOY    = parseFloat(document.getElementById('crop-oy').value);
    cropScale = parseFloat(document.getElementById('crop-sc').value) / 100;
    document.getElementById('crop-ox-val').textContent = Math.round(cropOX) + '%';
    document.getElementById('crop-oy-val').textContent = Math.round(cropOY) + '%';
    document.getElementById('crop-sc-val').textContent = cropScale.toFixed(2) + '×';
    applyCropToPreview();
  }

  function cropReset() {
    cropOX = 50; cropOY = 20; cropScale = 1.0;
    syncCropUI();
  }

  async function saveCrop() {
    if (!cropCharId) return;
    await savePortraitCrop(cropCharId, cropOX, cropOY, cropScale);
    await refreshData();
    closeCropModal();
    showToast('✦ Portrait adjusted');
  }

  function cropDragSensitivity() {
    const wrap = document.getElementById('crop-preview-wrap');
    return { sx: 100 / wrap.offsetWidth, sy: 100 / wrap.offsetHeight };
  }

  document.addEventListener('DOMContentLoaded', () => {
    const wrap = document.getElementById('crop-preview-wrap');

    wrap.addEventListener('mousedown', (e) => {
      cropDragging   = true;
      cropDragStartX = e.clientX;
      cropDragStartY = e.clientY;
      cropDragOX0    = cropOX;
      cropDragOY0    = cropOY;
      e.preventDefault();
    });
    document.addEventListener('mousemove', (e) => {
      if (!cropDragging) return;
      const { sx, sy } = cropDragSensitivity();
      cropOX = Math.max(0, Math.min(100, cropDragOX0 - (e.clientX - cropDragStartX) * sx));
      cropOY = Math.max(0, Math.min(100, cropDragOY0 - (e.clientY - cropDragStartY) * sy));
      syncCropUI();
    });
    document.addEventListener('mouseup', () => { cropDragging = false; });

    wrap.addEventListener('touchstart', (e) => {
      const t = e.touches[0];
      cropDragging   = true;
      cropDragStartX = t.clientX;
      cropDragStartY = t.clientY;
      cropDragOX0    = cropOX;
      cropDragOY0    = cropOY;
    }, { passive: true });
    document.addEventListener('touchmove', (e) => {
      if (!cropDragging) return;
      const t = e.touches[0];
      const { sx, sy } = cropDragSensitivity();
      cropOX = Math.max(0, Math.min(100, cropDragOX0 - (t.clientX - cropDragStartX) * sx));
      cropOY = Math.max(0, Math.min(100, cropDragOY0 - (t.clientY - cropDragStartY) * sy));
      syncCropUI();
    }, { passive: true });
    document.addEventListener('touchend', () => { cropDragging = false; });
  });

