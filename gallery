  async function seedIfEmpty() {
    const chars = await getAllCharacters();
    if (chars.length > 0) return;

    console.log('[DB] Seeding with sample data...');
    for (const sample of SAMPLE_CHARACTERS) {
      const charId = await addCharacterToDB(sample.name, sample.portraitUrl);
      for (const imgUrl of sample.images) {
        await addImageToDB(charId, imgUrl);
      }
    }
    console.log('[DB] Seed complete.');
